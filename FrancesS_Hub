local function RNGItemCount(id)
    -- Dump: Items["x1KDice_1"] = number
    local ok, d = pcall(function() return Stats.Local() end)
    if not ok or not d or not d.Items then return 0 end
    local key = id
    if not string.find(id, "_") then
        key = id .. "_1"
    end
    local v = d.Items[key]
    if type(v) == "number" then return v end
    if type(v) == "table" then return tonumber(v.Amount or v.amount or v.Count) or 0 end
    v = d.Items[id]
    if type(v) == "number" then return v end
    return 0
end

local function RNGDoRoll()
    if not ChannelRNG then return false, "no channel" end
    local okCall, a, b, c = pcall(function()
        return ChannelRNG:InvokeServer("Roll")
    end)
    if not okCall then return false, tostring(a) end
    if a == true then
        rngStats.ok += 1
        return true, nil, c
    end
    if b == "Cooldown" or (type(c) == "number" and c > workspace:GetServerTimeNow()) then
        rngStats.cd += 1
        return false, "Cooldown", c
    end
    return false, tostring(b or a), c
end

local function RNGCraft(index, isMax)
    if not ChannelCombine then return false end
    local ok, success = pcall(function()
        return ChannelCombine:InvokeServer("Craft", "Dices", index, isMax == true)
    end)
    return ok and success == true
end

