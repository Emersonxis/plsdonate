local function PotionItemCount(itemId, tier)
    local ok, d = pcall(function() return Stats.Local() end)
    if not ok or not d or not d.Items then return 0 end
    local key = string.format("%s_%s", tostring(itemId), tostring(tier or 1))
    local v = d.Items[key]
    if type(v) == "number" then return v end
    if type(v) == "table" then return tonumber(v.Amount or v.amount) or 0 end
    return 0
end

local function PotionGetSlot(slot)
    local ok, d = pcall(function() return Stats.Local() end)
    if not ok or not d or not d.PotionCrafts then return nil end
    return d.PotionCrafts[tostring(slot)]
end

local function PotionCanAfford(recipeId, amount)
    if not Directory or not Directory.PotionRecipes then return false end
    local rec = Directory.PotionRecipes[recipeId]
    if not rec or not rec.Ingredients then return false end
    amount = amount or 1
    for _, ing in pairs(rec.Ingredients) do
        local need = (ing.Amount or 1) * amount
        if PotionItemCount(ing.ItemId, ing.Tier or 1) < need then
            return false
        end
    end
    return true
end

local function PotionStartCraft(slot, recipeId, amount)
    if not ChannelPotion then return false end
    local ok, success = pcall(function()
        return ChannelPotion:InvokeServer("StartCraft", slot, recipeId, amount)
    end)
    return ok and success == true
end

local function PotionClaimCraft(slot)
    if not ChannelPotion then return false end
    local ok, success = pcall(function()
        return ChannelPotion:InvokeServer("ClaimCraft", slot)
    end)
    return ok and success == true
end

local function PotionBuildFamilies()
    table.clear(PotionFamilies)
    table.clear(PotionFamilyLabels)
    table.clear(PotionLabelToFamily)
    if not Directory or not Directory.PotionRecipes or not Directory.Items then return end
    for id, data in pairs(Directory.PotionRecipes) do
        if type(data) == "table" and data.ItemId and not data.PetId and not data.CurrencyId then
            local item = Directory.Items[data.ItemId]
            if item and item.Category == "Boosts" then
                local tier = tonumber(data.Tier) or 1
                local key = data.ItemId
                if not PotionFamilies[key] then
                    PotionFamilies[key] = { name = item.Name or key, tiers = {} }
                end
                PotionFamilies[key].tiers[tier] = id
            end
        end
    end
    local keys = {}
    for k in pairs(PotionFamilies) do table.insert(keys, k) end
    table.sort(keys, function(a, b)
        return PotionFamilies[a].name < PotionFamilies[b].name
    end)
    for _, k in ipairs(keys) do
        local f = PotionFamilies[k]
        local maxT = 0
        for ti in pairs(f.tiers) do if ti > maxT then maxT = ti end end
        local label = string.format("%s (até T%d)", f.name, maxT)
        table.insert(PotionFamilyLabels, label)
        PotionLabelToFamily[label] = k
    end
end

PotionBuildFamilies()

