                    local recipeId = PotionRecipeFor(familyKey, tier)
                    if recipeId and PotionStartOneSlot(recipeId) then
                        any = true
                        task.wait(0.12)
                    end
                end
            end
        end
        task.wait(any and 0.35 or 1.0)
    end
    potionCraftThread = nil
end

