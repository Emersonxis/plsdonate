local function FishGetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
end

local function FishNearPos()
    local root = FishGetRoot()
    if not root then return nil end
    return root.Position + root.CFrame.LookVector * BobberDistance + Vector3.new(0, -2, 0)
end

local function FishFindBobbers()
    local list = {}
    local function scan(parent, depth)
        if not parent or depth > 6 then return end
        for _, obj in ipairs(parent:GetChildren()) do
            local ok, isB = pcall(function() return obj:GetAttribute("FishingBobber") == true end)
            if ok and isB then table.insert(list, obj) end
            if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("WorldModel") then
                scan(obj, depth + 1)
            end
        end
    end
    scan(workspace, 0)
    local cam = workspace:FindFirstChildOfClass("Camera")
    if cam then scan(cam, 0) end
    return list
end

local function FishPullBobbers()
    if not PullBobber then return end
    local pos = FishNearPos()
    if not pos then return end
    for _, bobber in ipairs(FishFindBobbers()) do
        pcall(function()
            bobber:PivotTo(CFrame.new(pos))
            for _, d in ipairs(bobber:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.AssemblyLinearVelocity = Vector3.zero
                    d.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end
end

local function FishBlast(castId, n)
    if not castId or not SummerChannel then return end
    n = math.max(1, n or 1)
    for _ = 1, n do
        task.spawn(function()
            pcall(function() SummerChannel:FireServer("ReelHit", castId) end)
        end)
    end
end

local function FishDoReel(castId, requiredHits)
    if not InstantReel then return end
    local need = (type(requiredHits) == "number" and requiredHits > 0) and requiredHits or 1
    fishCastId = castId
    fishReeling = true
    local total = need + fishExtraHits
    -- múltiplas ondas = mais confiável quando o server atrasa
    FishBlast(castId, total)
    task.defer(function() FishBlast(castId, need) end)
    task.delay(0.05, function()
        if fishCastId == castId then FishBlast(castId, need) end
    end)
    task.delay(0.12, function()
        if fishCastId == castId then FishBlast(castId, need) end
    end)
    task.delay(0.25, function()
        if fishCastId == castId then FishBlast(castId, math.max(2, need)) end
    end)
end

local function FishSellOnce()
    if not SummerChannel then return end
    pcall(function()
        SummerChannel:InvokeServer("SellFish")
    end)
end

local function FishBind()
    if fishBound or not SummerChannel then return end
    fishBound = true

    SummerChannel.OnClientEvent("Cast"):Connect(function(castId)
        fishHasCast = true
        fishCastId = castId
        task.defer(FishPullBobbers)
        task.delay(0.08, FishPullBobbers)
    end)

    SummerChannel.OnClientEvent("ClearCast"):Connect(function()
        fishHasCast = false
        fishReeling = false
        fishCastId = nil
    end)

    SummerChannel.OnClientEvent("StartReel"):Connect(function(castId, requiredHits)
        fishHasCast = true
        FishDoReel(castId, requiredHits)
        FishPullBobbers()
    end)

    SummerChannel.OnClientEvent("AutoReelHit"):Connect(function(castId)
        if InstantReel then
            FishBlast(castId, 1 + fishExtraHits)
        end
    end)

    SummerChannel.OnClientEvent("Bite"):Connect(function(castId)
        fishCastId = castId
        fishHasCast = true
        FishPullBobbers()
        if InstantReel then
            FishBlast(castId, 2 + fishExtraHits)
            task.spawn(function()
                for _ = 1, 10 do
                    if fishCastId ~= castId then break end
                    FishBlast(castId, 2)
                    task.wait(0.04)
                end
            end)
        end
    end)

    SummerChannel.OnClientEvent("CaughtFish"):Connect(function()
        fishHasCast = false
        fishReeling = false
        if AutoSellFish then
            task.defer(FishSellOnce)
        end
    end)

    SummerChannel.OnClientEvent("AutoRodAction"):Connect(function(action)
        if action == "Cast" then
            fishHasCast = true
            task.defer(FishPullBobbers)
        elseif action == "Reel" and fishCastId and InstantReel then
            FishBlast(fishCastId, 4)
        end
    end)

    -- puxa isca enquanto cast ativo
    RunService.Heartbeat:Connect(function()
        if PullBobber and (fishHasCast or fishReeling) then
            FishPullBobbers()
        end
    end)

    -- reforço durante reel (anti “fica lento”)
    task.spawn(function()
        while true do
            task.wait(0.08)
            if InstantReel and fishReeling and fishCastId then
                FishBlast(fishCastId, 2)
            end
        end
    end)
end

pcall(FishBind)

