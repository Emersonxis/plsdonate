local function PickUUIDs(group, amount)
    local out = {}
    amount = math.min(amount, #group.uuids)
    for i = 1, amount do
        out[i] = group.uuids[i]
    end
    return out
end

local function DoCraftGolden(uuids)
    local ok, a, b, c = pcall(function()
        return PetsChannel:InvokeServer("CraftGolden", uuids)
    end)
    if not ok then return false end
    return (a or c == true) and a == true
end

local function DoStartRainbow(uuids)
    local ok, success = pcall(function()
        return PetsChannel:InvokeServer("StartRainbowCraft", uuids)
    end)
    if not ok then return false end
    return success == true
end

local function ClaimReadyRainbowSlots()
    local ok, data = pcall(function() return Stats.Local() end)
    if not ok or not data or not data.RainbowCrafts then return end

    local now = workspace:GetServerTimeNow()
    local saveAge = 0
    pcall(function() saveAge = Stats.GetSaveAge() or 0 end)

    for slot = 1, 3 do
        local craft = data.RainbowCrafts[slot]
        if craft and craft.EndTimestamp then
            local remaining = craft.EndTimestamp - now
            if craft.SaveAge ~= nil then
                remaining = remaining - (saveAge - craft.SaveAge) * 2
            end
            if remaining <= 0 then
                pcall(function()
                    PetsChannel:InvokeServer("ClaimRainbowCraft", slot)
                end)
            end
        end
    end
end

local function ShouldCraftKey(key)
    if CraftAllMode then return true end
    if next(SelectedCraftKeys) == nil then return false end
    return SelectedCraftKeys[key] == true
end

-- Craft loops: instantâneos (sem delay artificial)
local function GoldenLoop()
    while AutoGolden do
        local groups = BuildGroups()
        local required = GetGoldenRequiredCount()
        local want = GoldenQty > 0 and GoldenQty or required
        want = math.clamp(want, 1, required)

        local did = false
        for key, g in pairs(groups) do
            if not AutoGolden then break end
            if g.kind == "Normal" and ShouldCraftKey(key) and g.count >= want then
                DoCraftGolden(PickUUIDs(g, want))
                did = true
                break
            end
        end
        if not did then
            task.wait(0.4)
        end
        -- se craftou, re-scan imediatamente (yield mínimo)
        task.wait()
    end
    goldenThread = nil
end

local function RainbowLoop()
    while AutoRainbow do
        local groups = BuildGroups()
        local want = RainbowQty > 0 and RainbowQty or 6
        want = math.clamp(want, 1, 6)

        local did = false
        for key, g in pairs(groups) do
            if not AutoRainbow then break end
            if g.kind == "Golden" and ShouldCraftKey(key) and g.count >= want then
                DoStartRainbow(PickUUIDs(g, want))
                did = true
                break
            end
        end
        if not did then
            task.wait(0.4)
        end
        task.wait()
    end
    rainbowThread = nil
end

