local function GetDefaultVariant()
    return Constants.DefaultPetVariant
end

local function IsNormalVariant(v)
    local def = GetDefaultVariant()
    return v == nil or v == def or v == "Normal" or v == ""
end

local function GetGoldenRequiredCount()
    local reduction = 0
    pcall(function()
        reduction = MasteryFrontend.GetPower(Stats.Local(), "GoldenCraftPetReduction") or 0
    end)
    local n = 6 - reduction
    if n < 1 then n = 1 end
    if n > 6 then n = 6 end
    return n
end

local function GetPetDisplayName(petId)
    local info = Directory.Pets and Directory.Pets[petId]
    if info and info.Name then return info.Name end
    return tostring(petId)
end

local function GetPetRarity(petId)
    local info = Directory.Pets and Directory.Pets[petId]
    if info and info.Rarity then return info.Rarity end
    return "Unknown"
end

local function IsBlockedPet(pet)
    if not pet or not pet.id then return true end
    if pet.Locked == true then return true end
    local rarity = GetPetRarity(pet.id)
    if rarity == "Exclusive" or rarity == "Secret" then return true end
    if PetsModule.IsSecretPet then
        local ok, secret = pcall(PetsModule.IsSecretPet, pet.id)
        if ok and secret == true then return true end
    end
    return false
end

local function MakeKey(petId, isShiny, kind)
    return string.format("%s|%s|%s", petId, isShiny and "1" or "0", kind)
end

local function LabelFromGroup(g)
    local shinyTag = g.isShiny and " (Shiny)" or ""
    return string.format("%s%s — %s  x%d", g.name, shinyTag, g.kind, g.count)
end

local function BuildGroups()
    local groups = {}
    local ok, data = pcall(function() return Stats.Local() end)
    if not ok or not data or not data.Pets then return groups end

    for uuid, pet in pairs(data.Pets) do
        if type(pet) == "table" and not IsBlockedPet(pet) then
            local isShiny = pet.Shiny == true
            local kind = nil
            if IsNormalVariant(pet.v) then
                kind = "Normal"
            elseif pet.v == "Golden" then
                kind = "Golden"
            end
            if kind then
                local key = MakeKey(pet.id, isShiny, kind)
                if not groups[key] then
                    groups[key] = {
                        uuids = {},
                        petId = pet.id,
                        isShiny = isShiny,
                        kind = kind,
                        name = GetPetDisplayName(pet.id),
                        count = 0,
                    }
                end
                table.insert(groups[key].uuids, uuid)
                groups[key].count += 1
            end
        end
    end
    return groups
end

local function FingerprintPets()
    local ok, data = pcall(function() return Stats.Local() end)
    if not ok or not data or not data.Pets then return "" end
    local parts = {}
    for uuid, pet in pairs(data.Pets) do
        if type(pet) == "table" and pet.id then
            table.insert(parts, uuid .. ":" .. tostring(pet.v) .. ":" .. tostring(pet.Shiny) .. ":" .. tostring(pet.Locked))
        end
    end
    table.sort(parts)
    return table.concat(parts, ";")
end

