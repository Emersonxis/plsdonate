local function CollectEggsFromFolder(folder, eggs, seen)
    if not folder then return end
    for _, child in ipairs(folder:GetChildren()) do
        local name = child.Name
        if not string.match(name, "^RobuxEgg") and not seen[name] then
            seen[name] = true
            table.insert(eggs, name)
        end
    end
end

local function GetAllEggs()
    local eggs, seen = {}, {}

    local map = workspace:FindFirstChild("_MAP")
    if map then
        local interact = map:FindFirstChild("Interact")
        if interact then
            CollectEggsFromFolder(interact:FindFirstChild("Eggs"), eggs, seen)
        end
    end

    local things = workspace:FindFirstChild("_THINGS")
    if things then
        local function scan(parent, depth)
            if depth > 7 then return end
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "Eggs" and (child:IsA("Folder") or child:IsA("Model")) then
                    CollectEggsFromFolder(child, eggs, seen)
                elseif child:IsA("Folder") or child:IsA("Model") then
                    scan(child, depth + 1)
                end
            end
        end
        scan(things, 0)
    end

    if #eggs == 0 then
        local function scanWorkspace(parent, depth)
            if depth > 5 then return end
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "Eggs" and (child:IsA("Folder") or child:IsA("Model")) then
                    CollectEggsFromFolder(child, eggs, seen)
                elseif (child:IsA("Folder") or child:IsA("Model")) and child.Name ~= "Terrain" then
                    scanWorkspace(child, depth + 1)
                end
            end
        end
        scanWorkspace(workspace, 0)
    end

    if #eggs == 0 then table.insert(eggs, "ToyEgg") end
    table.sort(eggs)
    return eggs
end

local function TablesEqual(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
        if a[i] ~= b[i] then return false end
    end
    return true
end

