        end
    end
    return list
end

local function PotionRecipeFor(familyKey, tier)
    local f = PotionFamilies[familyKey]
    if not f then return nil end
    return f.tiers[tier]
end

-- 1 slot por família por passagem (todas as poções avançam)
local function PotionStartOneSlot(recipeId)
    if not recipeId then return false end
    local rec = Directory.PotionRecipes[recipeId]
    local maxA = rec and tonumber(rec.MaxAmount) or 6
    local amount = math.clamp(PotionCraftAmount, 1, maxA)
    if not PotionCanAfford(recipeId, amount) then return false end
    local empties = PotionEmptySlots()
    if #empties == 0 then return false end
    return PotionStartCraft(empties[1], recipeId, amount)
end

local function PotionCraftAllLoop()
