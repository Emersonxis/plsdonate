local function RNGRollLoop()
    while AutoRNGRoll do
        local ok, err, cd = RNGDoRoll()
        if ok then
            -- max
        elseif err == "Cooldown" and type(cd) == "number" then
            local w = cd - workspace:GetServerTimeNow()
            if w > 0.03 then task.wait(w - 0.02)
            elseif w > 0 then task.wait(w) end
        else
            task.wait(0.1)
        end
    end
    rngRollThread = nil
end

