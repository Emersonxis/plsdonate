local function DeleteMakeKey(petId, isShiny)
    return string.format("%s|%s", petId, isShiny and "1" or "0")
end

local function BuildDeleteGroups()
    local groups = {}
    local ok, data = pcall(function() return Stats.Local() end)
    if not ok or not data or not data.Pets then return groups end

    for uuid, pet in pairs(data.Pets) do
        if type(pet) == "table" and pet.id and not pet.Locked then
            local isShiny = pet.Shiny == true
            local key = DeleteMakeKey(pet.id, isShiny)
            if not groups[key] then
                groups[key] = {
                    petId = pet.id,
                    isShiny = isShiny,
                    name = GetPetDisplayName(pet.id),
                    normal = 0,
                    golden = 0,
                    rainbow = 0,
                    uuidsNormal = {},
                    uuidsGolden = {},
                    uuidsRainbow = {},
                }
            end
            local g = groups[key]
            if pet.v == "Golden" then
                g.golden += 1
                table.insert(g.uuidsGolden, uuid)
            elseif pet.v == "Rainbow" then
                g.rainbow += 1
                table.insert(g.uuidsRainbow, uuid)
            elseif IsNormalVariant(pet.v) then
                g.normal += 1
                table.insert(g.uuidsNormal, uuid)
            end
        end
    end
    return groups
end

local function DeleteLabel(g)
    local shiny = g.isShiny and " (Shiny)" or ""
    return string.format("%s%s  |  N:%d  G:%d  R:%d", g.name, shiny, g.normal, g.golden, g.rainbow)
end

local function RefreshDeletePetDropdown(showNotify)
    local groups = BuildDeleteGroups()
    local list = {}
    DeleteKeyFromLabel = {}
    for key, g in pairs(groups) do
        local label = DeleteLabel(g)
        table.insert(list, label)
        DeleteKeyFromLabel[label] = key
    end
    table.sort(list)

    if DeletePetDropdown and DeletePetDropdown.Refresh then
        pcall(function()
            DeletePetDropdown:Refresh(#list > 0 and list or { "(nenhum pet)" })
        end)
    end

    -- seleção persiste
    local still = {}
    for key in pairs(SelectedDeleteKeys) do
        if groups[key] then still[key] = true end
    end
    SelectedDeleteKeys = still

    if showNotify then
        local n = 0
        for _ in pairs(SelectedDeleteKeys) do n += 1 end
        Rayfield:Notify({
            Title = "Pets",
            Content = #list .. " grupos | selecionados: " .. n,
            Duration = 3,
        })
    end
    return groups
end

local function CollectDeleteUUIDs(groups)
    local uuids = {}
    for key in pairs(SelectedDeleteKeys) do
        local g = groups[key]
        if g then
            if DeleteNormal then
                for _, id in ipairs(g.uuidsNormal) do table.insert(uuids, id) end
            end
            if DeleteGolden then
                for _, id in ipairs(g.uuidsGolden) do table.insert(uuids, id) end
            end
            if DeleteRainbow then
                for _, id in ipairs(g.uuidsRainbow) do table.insert(uuids, id) end
            end
        end
    end
    return uuids
end

local function RunDeleteBatch(uuids)
    if #uuids == 0 then return 0 end
    local batchSize = 40
    local sent = 0
    for i = 1, #uuids, batchSize do
        local batch = {}
        for j = i, math.min(i + batchSize - 1, #uuids) do
            table.insert(batch, uuids[j])
        end
        local ok = pcall(function()
            PetsChannel:FireServer("DeletePetsBulk", batch)
        end)
        if ok then sent += #batch end
        task.wait(0.08)
    end
    return sent
end

local function AutoDeleteLoop()
    while AutoDeletePets do
        if next(SelectedDeleteKeys) ~= nil and (DeleteNormal or DeleteGolden or DeleteRainbow) then
            local groups = BuildDeleteGroups()
            local uuids = CollectDeleteUUIDs(groups)
            if #uuids > 0 then
                RunDeleteBatch(uuids)
            end
        end
        task.wait(0.75)
    end
    deletePetsThread = nil
end

