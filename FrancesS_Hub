local function RNGItemCount(id)
    local total = 0
    local ok, d = pcall(function() return Stats.Local() end)
    if not ok or not d then return 0 end
    if d.RNGDiceQueue and d.RNGDiceQueue[id] then
        total += tonumber(d.RNGDiceQueue[id]) or 0
    end
    if d.Items then
        local v = d.Items[id]
        if type(v) == "number" then total += v
        elseif type(v) == "table" then total += tonumber(v.Amount or v.amount or v.Count) or 0 end
    end
    return total
end

local function RNGDoRoll()
    if not ChannelRNG then return false, "no channel" end
    local okCall, a, b, c = pcall(function()
        return ChannelRNG:InvokeServer("Roll")
    end)
    if not okCall then return false, tostring(a) end
    if a == true then
        rngStats.ok += 1
        return true, nil, c
    end
    if b == "Cooldown" or (type(c) == "number" and c > workspace:GetServerTimeNow()) then
        rngStats.cd += 1
        return false, "Cooldown", c
    end
    return false, tostring(b or a), c
end

local function RNGCraft(index, isMax)
    if not ChannelCombine then return false end
    local ok, success = pcall(function()
        return ChannelCombine:InvokeServer("Craft", "Dices", index, isMax == true)
    end)
    return ok and success == true
end

-- Lucky chain only (NO Rainbow): 1=x1K→100K, 2=100K→Golden, 3=Golden→x1M
local RNG_DICE_CHAIN = {
    { index = 1, from = "x1KDice", need = 30 },
    { index = 2, from = "x100KDice", need = 9 },
    { index = 3, from = "GoldenDice", need = 6 },
}

local function RNGRollLoop()
    while AutoRNGRoll do
        local ok, err, cd = RNGDoRoll()
        if ok then
            -- max
        elseif err == "Cooldown" and type(cd) == "number" then
            local w = cd - workspace:GetServerTimeNow()
            if w > 0.03 then task.wait(w - 0.02)
            elseif w > 0 then task.wait(w) end
        else
            task.wait(0.1)
        end
    end
    rngRollThread = nil
end

local function RNGCraftLoop()
    -- Sempre manda Craft pro server (igual botão 1x). Server valida inventário.
    while AutoRNGCraft do
        local did = false
        for _, c in ipairs(RNG_DICE_CHAIN) do
            if not AutoRNGCraft then break end
            if RNGCraft(c.index, true) then did = true end
            task.wait(0.15)
        end
        task.wait(did and 0.2 or 0.7)
    end
    rngCraftThread = nil
end

local function RNGBoostLoop()
    local upgrades = { "LuckMultiplier", "PixelCoinsMultiplier", "BreakablesIncremental" }
    local skills = {
        "RNGFasterRolls", "RNGFasterRollsII", "RNGFasterRollsIII", "RNGFasterRollsIV",
        "RNGBonusRoll", "RNGBonusRollII", "RNGBonusRollIII",
        "RNGGoldenRoll", "RNGGoldenRollII", "RNGGoldenRollIII",
    }
    while AutoRNGBoost do
        local did = false
        if ChannelRNGUpgrades then
            for _, id in ipairs(upgrades) do
                if not AutoRNGBoost then break end
                local ok = pcall(function()
                    ChannelRNGUpgrades:InvokeServer("Purchase", id, 20)
                end)
                if ok then did = true end
                task.wait(0.08)
            end
        end
        if SkillTreeFrontend and SkillTreeFrontend.Purchase then
            for _, id in ipairs(skills) do
                if not AutoRNGBoost then break end
                local ok = pcall(function() SkillTreeFrontend.Purchase(id, "RNG") end)
                if ok then did = true end
                task.wait(0.1)
            end
        end
        task.wait(did and 0.4 or 1.5)
    end
    rngBoostThread = nil
end

