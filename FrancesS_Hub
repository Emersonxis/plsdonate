-- Compra todo stock de uma oferta de uma vez
local function BuyAllMerchantOffers()
    local okState, state = pcall(function()
        return MerchantChannel:InvokeServer("GetState")
    end)
    if not okState or not state or not state.IsActive then
        return false, 0
    end

    local okOffers, offers = pcall(function()
        return MerchantChannel:InvokeServer("GetOffers")
    end)
    if not okOffers or type(offers) ~= "table" then
        return false, 0
    end

    local bought = 0
    for _, offer in ipairs(offers) do
        if offer.Unlocked and offer.Stock and offer.Stock > 0 and offer.OfferKey then
            -- compra cada unidade do stock restante o mais rápido possível
            local stock = offer.Stock
            for _ = 1, stock do
                local okBuy = pcall(function()
                    MerchantChannel:InvokeServer("Buy", offer.OfferKey)
                end)
                if okBuy then
                    bought += 1
                else
                    break
                end
            end
        end
    end
    return true, bought
end

local function MerchantIsActive()
    local ok, state = pcall(function()
        return MerchantChannel:InvokeServer("GetState")
    end)
    return ok and state and state.IsActive == true
end

