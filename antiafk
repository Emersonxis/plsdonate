local UIS = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local player = Players.LocalPlayer

local enabled = true

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 4
        })
    end)
end

-- Comandos de chat (funcionam desde o início)
player.Chatted:Connect(function(msg)
    msg = string.lower(msg)
    
    if msg == "!afkon" then
        enabled = true
        notify("Anti AFK", "Ativado ✅")
    elseif msg == "!afkoff" then
        enabled = false
        notify("Anti AFK", "Desativado ❌")
    end
end)

-- Aguarda 5 minutos antes de iniciar
notify("Anti AFK", "Aguardando 5 minutos para iniciar...")
task.wait(300)

notify("Anti AFK", "Ativado ✅\nUse !afkon e !afkoff no chat")

-- Função principal (segura para menus)
local function doAntiAFK()
    if not enabled then return end
    
    -- Não faz nada se o menu de pause/configurações estiver aberto
    if GuiService.MenuIsOpen then return end

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new()) -- clique direito silencioso (não interfere na UI)
    end)
end

-- Só quando o Roblox detecta idle (melhor método)
pcall(function()
    player.Idled:Connect(function()
        if enabled then
            doAntiAFK()
        end
    end)
end)

-- Loop de segurança bem espaçado (só se o menu não estiver aberto)
task.spawn(function()
    while true do
        task.wait(720) -- 12 minutos
        if enabled and not GuiService.MenuIsOpen then
            doAntiAFK()
        end
    end
end)
