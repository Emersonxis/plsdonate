-- [9]: Auto Craft (a cada 3s) - com bloqueio de GUI
task.spawn(function()
    while task.wait(3) do
        if not State.AutoCraft then continue end
        
        pcall(function()
            -- Forçar fechar GUIs de craft enquanto auto craft está ativo
            local menus = player.PlayerGui:FindFirstChild("Main")
            if menus then
                menus = menus:FindFirstChild("Menus")
                if menus then
                    local rolling = menus:FindFirstChild("CraftingRollingFrame")
                    local crafting = menus:FindFirstChild("CraftingFrame")
                    if rolling then rolling.Visible = false end
                    if crafting then crafting.Visible = false end
                end
            end
            
            local playerData = DataClient.GetPlayerData()
            if not playerData or not playerData.Pets then return end
            
            -- Agrupar pets por nome+tier+size
            local groups = {}
            for petId, petData in pairs(playerData.Pets) do
                if not petData.Equipped then
                    local tier = petData.CraftTier or 0
                    local size = petData.PetSize or 0
                    local key = petData.PetName .. "|" .. tier .. "|" .. size
                    
                    if not groups[key] then
                        groups[key] = { name = petData.PetName, tier = tier, size = size, ids = {} }
                    end
                    groups[key].ids[#groups[key].ids + 1] = petId
                end
            end
            
            -- Normal -> Golden (8 pets)
            for _, group in pairs(groups) do
                if not State.AutoCraft then return end
                if group.tier == 0 and #group.ids >= 8 then
                    local selected = {}
                    for i = 1, 8 do
                        selected[group.ids[i]] = true
                    end
                    PetEvent:FireServer("CraftPet", {
                        [1] = group.name,
                        [2] = selected,
                        [3] = "Golden",
                        [4] = group.size
                    })
                    task.wait(2)
                end
            end
            
            -- Re-buscar dados para Golden -> Ruby
            if not State.AutoCraft then return end
            task.wait(1)
            
            playerData = DataClient.GetPlayerData()
            if not playerData or not playerData.Pets then return end
            
            local groups2 = {}
            for petId, petData in pairs(playerData.Pets) do
                if not petData.Equipped then
                    local tier = petData.CraftTier or 0
                    local size = petData.PetSize or 0
                    local key = petData.PetName .. "|" .. tier .. "|" .. size
                    
                    if not groups2[key] then
                        groups2[key] = { name = petData.PetName, tier = tier, size = size, ids = {} }
                    end
                    groups2[key].ids[#groups2[key].ids + 1] = petId
                end
            end
            
            -- Golden -> Ruby (6 pets)
            for _, group in pairs(groups2) do
                if not State.AutoCraft then return end
                if group.tier == 1 and #group.ids >= 6 then
                    local selected = {}
                    for i = 1, 6 do
                        selected[group.ids[i]] = true
                    end
                    PetEvent:FireServer("CraftPet", {
                        [1] = group.name,
                        [2] = selected,
                        [3] = "Ruby",
                        [4] = group.size
                    })
                    task.wait(2)
                end
            end
        end)
    end
end)

