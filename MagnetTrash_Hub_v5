-- [1]: Bloquear Animações (Ovos, Caixas e CRAFT) - executa UMA vez
task.spawn(function()
    -- Desabilitar conexões de animação
    if getconnections then
        for _, eventName in ipairs({"EggEvent", "HatEvent", "CrateEvent"}) do
            local event = RemoteEvents:FindFirstChild(eventName)
            if event then
                for _, conn in pairs(getconnections(event.OnClientEvent)) do
                    conn:Disable()
                end
            end
        end
    end
    
    -- Esconder GUIs de Craft (CraftingRollingFrame + CraftingFrame)
    pcall(function()
        local menus = player.PlayerGui.Main.Menus
        local craftingRollingFrame = menus:FindFirstChild("CraftingRollingFrame")
        local craftingFrame = menus:FindFirstChild("CraftingFrame")
        
        if craftingRollingFrame then
            craftingRollingFrame.Visible = false
            craftingRollingFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                if State.AutoCraft then
                    craftingRollingFrame.Visible = false
                end
            end)
        end
        
        if craftingFrame then
            craftingFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                if State.AutoCraft then
                    craftingFrame.Visible = false
                end
            end)
        end
    end)
    
    -- Hook modules de animação
    if hookfunction then
        local function hookModule(moduleName, funcNames)
            pcall(function()
                local mod = require(player.PlayerScripts.ClientModules:FindFirstChild(moduleName))
                if mod then
                    for _, funcName in ipairs(funcNames) do
                        if mod[funcName] then
                            hookfunction(mod[funcName], function() return end)
                        end
                    end
                end
            end)
        end
        hookModule("EggClient", {"AnimateEggs", "RenderEggBatch"})
        hookModule("HatClient", {"AnimateHats", "RenderHatBatch", "AnimateCrates", "RenderCrateBatch"})
        hookModule("CrateClient", {"AnimateCrates", "RenderCrateBatch", "AnimateHats", "RenderHatBatch"})
    end
    
    -- Destruir modelos de animação na câmera
    workspace.CurrentCamera.ChildAdded:Connect(function(child)
        task.defer(function()
            if child and child.Parent then
                child:Destroy()
            end
        end)
    end)
end)

