            if not playerData or not playerData.Relics or not playerData.Relics.Relics then return end
            
            local idsToDelete = {}
            
            for relicId, relicData in pairs(playerData.Relics.Relics) do
                if relicData and not relicData.Equipped then
                    local relicName = relicData.RelicName
                    for _, targetName in ipairs(State.RelicsToDelete) do
                        if relicName == targetName then
                            idsToDelete[#idsToDelete + 1] = relicId
                            break
                        end
                    end
                end
            end
            
            if #idsToDelete > 0 then
                RelicsEvent:FireServer("Delete", idsToDelete)
            end
        end)
    end
end)
