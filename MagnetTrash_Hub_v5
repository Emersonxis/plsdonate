-- [5]: Trashes + Orbs (a cada 1.5s, unificado)
task.spawn(function()
    while task.wait(1.5) do
        if not State.AutoTrash and not State.AutoOrbs then continue end
        
        local rootPart = getRootPart()
        if not rootPart then continue end
        local rootCFrame = rootPart.CFrame
        local rootPos = rootPart.Position
        
        pcall(function()
            if State.AutoTrash then
                local radius = State.TrashRadius
                for _, item in ipairs(workspace.Scriptable.Trashes:GetChildren()) do
                    local pos
                    if item:IsA("Model") then
                        pos = item:GetPivot().Position
                    elseif item:IsA("BasePart") then
                        pos = item.Position
                    end
                    if pos and (rootPos - pos).Magnitude <= radius then
                        if item:IsA("Model") then
                            item:PivotTo(rootCFrame)
                        else
                            item.CFrame = rootCFrame
                        end
                    end
                end
            end
            
            if State.AutoOrbs then
                local orbs = workspace.Scriptable.Orbs:GetChildren()
                local count = #orbs
                if count > 0 then
                    for i, orb in ipairs(orbs) do
                        local angle = (i / count) * math.pi * 2
                        local offsetX = math.cos(angle) * 2
                        local offsetZ = math.sin(angle) * 2
                        local targetCFrame = CFrame.new(rootPos.X + offsetX, rootPos.Y + 1.5, rootPos.Z + offsetZ)
                        if orb:IsA("Model") then
                            orb:PivotTo(targetCFrame)
                        elseif orb:IsA("BasePart") then
                            orb.CFrame = targetCFrame
                        end
                    end
                end
            end
        end)
    end
end)

