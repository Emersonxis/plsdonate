-- HELPER: pegar rootPart do player
-- ==========================================
local function getRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

-- ==========================================
-- HELPER: checar se quest está pronta para claim
-- ==========================================
local function isQuestReady()
    local ok, result = pcall(function()
        local questData = (DataClient.Data.Quests.Wizard or {}).Quest or {}
        if not next(questData) then return false end
        local requirements = questData.Requirements or {}
        local questName = questData.Name or ""
        local questStats = QuestsStats.NPCs.Wizard.Quests[questName]
        if not questStats then return false end
        for i, req in ipairs(requirements) do
            if questStats.Requirements[i].Amount > (req.Progress or 0) then
                return false
            end
        end
        return true
    end)
    return ok and result
end

-- ==========================================
-- HELPER: checar se tem quest ativa
-- ==========================================
local function hasActiveQuest()
    local ok, result = pcall(function()
        local questData = (DataClient.Data.Quests.Wizard or {}).Quest or {}
        for _, v in pairs(questData) do
            if v then return true end
        end
        return false
    end)
    return ok and result
end

-- ==========================================
-- HELPER: checar se PlayTime reward está pronto
-- ==========================================
local function isPlayTimeReady()
    local ok, result = pcall(function()
        local osTime = ReplicatedStorage:FindFirstChild("OsTime")
        local currentTime = osTime and osTime.Value or 0
        local claimableOn = player:GetAttribute("EggClaimableOn") or 0
        return (claimableOn - currentTime) <= 0
    end)
    return ok and result
end

