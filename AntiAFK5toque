-- ====================== FUNÇÕES ======================
local function setFPS(cap)
	pcall(function()
		if setfpscap then setfpscap(cap) end
	end)
end

local function setFFlagsLow()
	if type(setfflag) \~= "function" then return end
	pcall(function()
		setfflag("DFIntTaskSchedulerTargetFps", tostring(currentAfkFps))
		setfflag("DFIntDebugFRMQualityLevelOverride", "1")
		setfflag("FFlagDisablePostFx", "True")
		setfflag("FIntRenderShadowIntensity", "0")
		setfflag("FIntFRMMaxGrassDistance", "0")
		setfflag("FIntFRMMinGrassDistance", "0")
		setfflag("DFFlagDebugPauseVoxelizer", "True")
	end)
end

local function setFFlagsNormal()
	if type(setfflag) \~= "function" then return end
	pcall(function()
		setfflag("DFIntTaskSchedulerTargetFps", "60")
		setfflag("DFIntDebugFRMQualityLevelOverride", "0")
		setfflag("FFlagDisablePostFx", "False")
		setfflag("FIntRenderShadowIntensity", "1")
		setfflag("DFFlagDebugPauseVoxelizer", "False")
	end)
end

local function formatarTempo(s)
	return string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor(s%3600/60), math.floor(s%60))
end

local function atualizarInfo()
	if not infoFrame.Visible then return end
	local ping = 0
	pcall(function() ping = math.floor(player:GetNetworkPing() * 1000) end)
	local mem = 0
	pcall(function() mem = math.floor(collectgarbage("count") / 1024) end)

	infoLabel.Text = string.format(
[[FPS Atual: %d
Tempo AFK: %s
Ping: %d ms
Memória: %d MB
Players: %d

FPS Cap atual: %d]],
		fps,
		formatarTempo(tick() - tempoInicioAfk),
		ping,
		mem,
		#Players:GetPlayers(),
		currentAfkFps
	)
end

local function aplicarOtimizacoes()
	pcall(function() RunService:Set3dRenderingEnabled(false) end)
	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	Lighting.GlobalShadows = false
	Lighting.Brightness = 0
	Lighting.Ambient = Color3.new(0, 0, 0)
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
	Lighting.FogEnd = 0
	camera.FieldOfView = 1

	setFPS(currentAfkFps)
	setFFlagsLow()
end

local function esconderCore()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)
end

local function mostrarCore()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)
end

local function ligarEconomia()
	if _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = true
	tempoInicioAfk = tick()
	currentAfkFps = FPS_AFK
	fpsBox.Text = tostring(currentAfkFps)

	pcall(function()
		originais.FOV = camera.FieldOfView
		originais.QualityLevel = settings().Rendering.QualityLevel
		originais.GlobalShadows = Lighting.GlobalShadows
		originais.Brightness = Lighting.Brightness
		originais.Ambient = Lighting.Ambient
		originais.OutdoorAmbient = Lighting.OutdoorAmbient
		originais.FogEnd = Lighting.FogEnd
	end)

	btnAtivar.Visible = false
	black.Visible = true
	infoFrame.Visible = false
	UserInputService.MouseIconEnabled = false
	esconderCore()
	aplicarOtimizacoes()
end

local function desligarEconomia()
	if not _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = false

	black.Visible = false
	infoFrame.Visible = false
	btnAtivar.Visible = true
	UserInputService.MouseIconEnabled = true

	pcall(function() RunService:Set3dRenderingEnabled(true) end)
	setFPS(FPS_NORMAL)
	setFFlagsNormal()
	mostrarCore()

	pcall(function()
		camera.FieldOfView = originais.FOV or 70
		if originais.QualityLevel then
			settings().Rendering.QualityLevel = originais.QualityLevel
		else
			settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
		end
		Lighting.GlobalShadows = originais.GlobalShadows
		Lighting.Brightness = originais.Brightness
		Lighting.Ambient = originais.Ambient
		Lighting.OutdoorAmbient = originais.OutdoorAmbient
		Lighting.FogEnd = originais.FogEnd or 100000
	end)

	toques = 0
	isHolding = false
	ultimoMovimento = tick()
end

-- ====================== CONEXÕES ======================
btnAtivar.Activated:Connect(ligarEconomia)

-- TextBox FPS
fpsBox.FocusLost:Connect(function(enter)
	if enter then
		local num = tonumber(fpsBox.Text)
		if num then
			currentAfkFps = math.clamp(math.floor(num), 5, 60)
			fpsBox.Text = tostring(currentAfkFps)
			setFPS(currentAfkFps)
			setFFlagsLow()
			atualizarInfo()
		else
			fpsBox.Text = tostring(currentAfkFps)
		end
	end
end)

-- 5 toques + Hold na tela preta
black.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		local agora = tick()
		if agora - tempoUltimoToque > TEMPO_RESET_CLIQUES then
			toques = 0
		end
		toques += 1
		tempoUltimoToque = agora

		if toques >= CLIQUES_PARA_SAIR then
			desligarEconomia()
			return
		end

		isHolding = true
		holdStart = agora
	end
end)

black.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		isHolding = false
	end
end)

-- 5 toques para ativar (quando não está em AFK)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp or _G.ModoAfkAtivado then return end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		local agora = tick()
		if agora - tempoUltimoToque > TEMPO_RESET_CLIQUES then
			toques = 0
		end
		toques += 1
		tempoUltimoToque = agora

		if toques >= CLIQUES_PARA_SAIR then
			toques = 0
			ligarEconomia()
		end
	end
end)

-- Loops
task.spawn(function()
	RunService.RenderStepped:Connect(function()
		frameCount += 1
		if tick() - lastFpsUpdate >= 1 then
			fps = frameCount
			frameCount = 0
			lastFpsUpdate = tick()
			atualizarInfo()
		end
	end)

	while true do
		task.wait(0.12)

		if _G.ModoAfkAtivado and isHolding and (tick() - holdStart) >= TEMPO_HOLD then
			infoFrame.Visible = true
			atualizarInfo()
			isHolding = false
			task.delay(TEMPO_INFO, function()
				if infoFrame then infoFrame.Visible = false end
			end)
		end

		if _G.ModoAfkAtivado then
			UserInputService.MouseIconEnabled = false
			pcall(function() RunService:Set3dRenderingEnabled(false) end)
			setFPS(currentAfkFps)
		end
	end
end)

-- Standby por tempo parado
task.spawn(function()
	while true do
		task.wait(1.2)
		local mudou = false
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local pos = char.HumanoidRootPart.Position
			if (pos - ultimaPosicao).Magnitude > 0.15 then
				mudou = true
				ultimaPosicao = pos
			end
		end
		local look = camera.CFrame.LookVector
		if (look - ultimoLook).Magnitude > 0.05 then
			mudou = true
			ultimoLook = look
		end

		if mudou then
			if not _G.ModoAfkAtivado then
				ultimoMovimento = tick()
			end
		else
			if not _G.ModoAfkAtivado and (tick() - ultimoMovimento) >= TEMPO_STANDBY then
				ligarEconomia()
			end
		end
	end
end)
