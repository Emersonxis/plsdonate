local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local CoreGui = game:GetService("CoreGui")
local uiParent = pcall(function() return CoreGui.Name end) and CoreGui or player:WaitForChild("PlayerGui")

if uiParent:FindFirstChild("BatterySaverAFK") then
	uiParent["BatterySaverAFK"]:Destroy()
end

-- ==================== CONFIGURAÇÕES ====================
local TEMPO_STANDBY = 60
local cliquesParaSair = 5
local FPS_AFK = 10
local FPS_NORMAL = 60
local TEMPO_RESET_CLIQUES = 2.5
local TEMPO_HOLD = 0.6
local TEMPO_INFO = 12
-- =======================================================

_G.ModoAfkAtivado = false
local ultimoMovimento = tick()
local toques = 0
local tempoUltimoToque = 0
local screenGui, background, infoFrame, infoLabel, fpsBox
local clickConnection = nil
local isHolding = false
local holdStart = 0
local currentAfkFps = FPS_AFK
local tempoInicioAfk = 0

local fps = 60
local frameCount = 0
local lastFpsUpdate = tick()

local ultimaPosicao = Vector3.new()
local ultimoLookVector = Vector3.new()

local function setFPS(cap)
	pcall(function()
		if setfpscap then
			setfpscap(cap)
		end
	end)
end

local function setFFlagsLow()
	if type(setfflag) \~= "function" then return end
	pcall(function()
		setfflag("DFIntTaskSchedulerTargetFps", tostring(currentAfkFps))
		setfflag("DFIntDebugFRMQualityLevelOverride", "1")
		setfflag("FFlagDisablePostFx", "True")
		setfflag("FIntRenderShadowIntensity", "0")
		setfflag("FIntFRMMaxGrassDistance", "0")
		setfflag("FIntFRMMinGrassDistance", "0")
		setfflag("DFFlagDebugPauseVoxelizer", "True")
	end)
end

local function setFFlagsNormal()
	if type(setfflag) \~= "function" then return end
	pcall(function()
		setfflag("DFIntTaskSchedulerTargetFps", "60")
		setfflag("DFIntDebugFRMQualityLevelOverride", "0")
		setfflag("FFlagDisablePostFx", "False")
		setfflag("FIntRenderShadowIntensity", "1")
		setfflag("DFFlagDebugPauseVoxelizer", "False")
	end)
end

local function formatarTempo(s)
	return string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), math.floor(s%60))
end

local function atualizarInfo()
	if not infoLabel or not infoFrame or not infoFrame.Visible then return end
	local ping = 0
	pcall(function() ping = math.floor(player:GetNetworkPing() * 1000) end)
	local mem = 0
	pcall(function() mem = math.floor(collectgarbage("count") / 1024) end)

	infoLabel.Text = string.format(
[[FPS: %d
AFK Timer: %s
Ping: %d ms
Memória: %d MB
Players: %d

FPS Cap: %d]],
		fps,
		formatarTempo(tick() - tempoInicioAfk),
		ping,
		mem,
		#Players:GetPlayers(),
		currentAfkFps
	)
end

local function aplicarOtimizacoesPesadas()
	pcall(function()
		RunService:Set3dRenderingEnabled(false)
	end)

	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	Lighting.GlobalShadows = false
	Lighting.FogEnd = 0
	Lighting.Brightness = 0
	Lighting.Ambient = Color3.new(0, 0, 0)
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)

	camera.FieldOfView = 1
	setFPS(currentAfkFps)
	setFFlagsLow()
end

local function desligarEconomia()
	if not _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = false

	UserInputService.MouseIconEnabled = true

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)

	-- Volta a renderização 3D
	pcall(function()
		RunService:Set3dRenderingEnabled(true)
	end)

	setFPS(FPS_NORMAL)
	setFFlagsNormal()

	-- Restaura câmera e lighting com força
	pcall(function()
		camera.FieldOfView = 70

		settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic

		Lighting.GlobalShadows = true
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(140, 140, 140)
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		Lighting.FogColor = Color3.fromRGB(192, 192, 192)
	end)

	-- Força atualização do lighting
	pcall(function()
		local temp = Instance.new("ColorCorrectionEffect")
		temp.Parent = Lighting
		task.wait(0.1)
		temp:Destroy()
	end)

	if clickConnection then
		clickConnection:Disconnect()
		clickConnection = nil
	end

	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end

	infoFrame = nil
	infoLabel = nil
	fpsBox = nil
	toques = 0
	isHolding = false
	ultimoMovimento = tick()
end

local function ligarEconomia()
	if _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = true
	tempoInicioAfk = tick()
	currentAfkFps = FPS_AFK

	UserInputService.MouseIconEnabled = false

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BatterySaverAFK"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.ResetOnSpawn = false
	screenGui.Parent = uiParent

	background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BorderSizePixel = 0
	background.Active = true
	background.Parent = screenGui

	-- Painel de informações
	infoFrame = Instance.new("Frame")
	infoFrame.Size = UDim2.new(0, 270, 0, 300)
	infoFrame.Position = UDim2.new(0.5, -135, 0.5, -150)
	infoFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
	infoFrame.BackgroundTransparency = 0.1
	infoFrame.Visible = false
	infoFrame.Parent = background
	Instance.new("UICorner", infoFrame).CornerRadius = UDim.new(0, 12)

	infoLabel = Instance.new("TextLabel")
	infoLabel.Size = UDim2.new(1, -20, 0, 180)
	infoLabel.Position = UDim2.new(0, 10, 0, 10)
	infoLabel.BackgroundTransparency = 1
	infoLabel.TextColor3 = Color3.fromRGB(0, 255, 140)
	infoLabel.Font = Enum.Font.Code
	infoLabel.TextSize = 15
	infoLabel.TextXAlignment = Enum.TextXAlignment.Left
	infoLabel.TextYAlignment = Enum.TextYAlignment.Top
	infoLabel.Parent = infoFrame

	-- TextBox FPS
	fpsBox = Instance.new("TextBox")
	fpsBox.Size = UDim2.new(0, 90, 0, 32)
	fpsBox.Position = UDim2.new(0.5, -45, 1, -50)
	fpsBox.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
	fpsBox.Text = tostring(FPS_AFK)
	fpsBox.TextColor3 = Color3.fromRGB(0, 255, 150)
	fpsBox.Font = Enum.Font.GothamBold
	fpsBox.TextSize = 16
	fpsBox.ClearTextOnFocus = false
	fpsBox.Parent = infoFrame
	Instance.new("UICorner", fpsBox).CornerRadius = UDim.new(0, 6)

	fpsBox.FocusLost:Connect(function(enter)
		if enter then
			local num = tonumber(fpsBox.Text)
			if num then
				currentAfkFps = math.clamp(math.floor(num), 5, 60)
				fpsBox.Text = tostring(currentAfkFps)
				setFPS(currentAfkFps)
				setFFlagsLow()
				atualizarInfo()
			else
				fpsBox.Text = tostring(currentAfkFps)
			end
		end
	end)

	-- 5 cliques para sair + hold
	toques = 0
	tempoUltimoToque = 0

	clickConnection = background.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			local agora = tick()

			if agora - tempoUltimoToque > TEMPO_RESET_CLIQUES then
				toques = 0
			end
			toques = toques + 1
			tempoUltimoToque = agora

			if toques >= cliquesParaSair then
				desligarEconomia()
				return
			end

			isHolding = true
			holdStart = agora
		end
	end)

	background.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			isHolding = false
		end
	end)

	aplicarOtimizacoesPesadas()
end

-- 5 cliques para ativar
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if _G.ModoAfkAtivado then return end

	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		local agora = tick()

		if agora - tempoUltimoToque > TEMPO_RESET_CLIQUES then
			toques = 0
		end
		toques = toques + 1
		tempoUltimoToque = agora

		if toques >= cliquesParaSair then
			toques = 0
			ligarEconomia()
		end
	end
end)

-- Loops
task.spawn(function()
	RunService.RenderStepped:Connect(function()
		frameCount = frameCount + 1
		if tick() - lastFpsUpdate >= 1 then
			fps = frameCount
			frameCount = 0
			lastFpsUpdate = tick()
			atualizarInfo()
		end
	end)

	while true do
		task.wait(0.15)

		if _G.ModoAfkAtivado and isHolding and (tick() - holdStart) >= TEMPO_HOLD then
			if infoFrame then
				infoFrame.Visible = true
				atualizarInfo()
			end
			isHolding = false
			task.delay(TEMPO_INFO, function()
				if infoFrame then
					infoFrame.Visible = false
				end
			end)
		end

		if _G.ModoAfkAtivado then
			UserInputService.MouseIconEnabled = false
			pcall(function()
				RunService:Set3dRenderingEnabled(false)
			end)
			setFPS(currentAfkFps)
		end
	end
end)

-- Standby
task.spawn(function()
	while true do
		task.wait(1)

		local mudouFisica = false
		local character = player.Character

		if character and character:FindFirstChild("HumanoidRootPart") then
			local posAtual = character.HumanoidRootPart.Position
			if (posAtual - ultimaPosicao).Magnitude > 0.1 then
				mudouFisica = true
				ultimaPosicao = posAtual
			end
		end

		local lookAtual = camera.CFrame.LookVector
		if (lookAtual - ultimoLookVector).Magnitude > 0.05 then
			mudouFisica = true
			ultimoLookVector = lookAtual
		end

		if mudouFisica then
			if not _G.ModoAfkAtivado then
				ultimoMovimento = tick()
			end
		else
			if not _G.ModoAfkAtivado and (tick() - ultimoMovimento) >= TEMPO_STANDBY then
				ligarEconomia()
			end
		end
	end
end)
