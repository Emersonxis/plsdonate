local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local CoreGui = game:GetService("CoreGui")
local uiParent = pcall(function() return CoreGui.Name end) and CoreGui or player:WaitForChild("PlayerGui")

if uiParent:FindFirstChild("BatterySaverAFK") then
	uiParent["BatterySaverAFK"]:Destroy()
end

-- ==================== CONFIGURAÇÕES ====================
local TEMPO_STANDBY = 60          -- segundos parado para ativar o modo
local cliquesParaSair = 3         -- cliques rápidos para sair
local FPS_AFK = 10                -- FPS só enquanto a tela preta estiver ativa
local FPS_NORMAL = 120             -- FPS quando sair do modo
-- =======================================================

_G.ModoAfkAtivado = false
local ultimoMovimento = tick()
local toques = 0
local tempoUltimoToque = 0
local screenGui, background

local ultimaPosicao = Vector3.new()
local ultimoLookVector = Vector3.new()

local function aplicarOtimizacoesPesadas()
	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	pcall(function()
		settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
	end)

	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Brightness = 0
	Lighting.Ambient = Color3.new(0, 0, 0)
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)

	pcall(function()
		Lighting.Technology = Enum.Technology.Compatibility
	end)

	-- Remove todos os efeitos de pós-processamento
	for _, efeito in pairs(Lighting:GetChildren()) do
		if efeito:IsA("PostEffect") or efeito:IsA("Atmosphere") or efeito:IsA("Sky")
			or efeito:IsA("BloomEffect") or efeito:IsA("BlurEffect")
			or efeito:IsA("ColorCorrectionEffect") or efeito:IsA("SunRaysEffect")
			or efeito:IsA("DepthOfFieldEffect") then
			efeito:Destroy()
		end
	end

	-- Desliga todos os sons
	for _, som in pairs(SoundService:GetDescendants()) do
		if som:IsA("Sound") then
			som.Volume = 0
			som:Stop()
		end
	end

	-- Otimizações pesadas de partes + MeshParts
	for _, obj in pairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Material = Enum.Material.SmoothPlastic
			obj.Reflectance = 0
			obj.CastShadow = false

			if obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
				obj.RenderFidelity = Enum.RenderFidelity.Performance
			end
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			obj.Transparency = 1
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
			or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
			obj.Enabled = false
		elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
			obj.Enabled = false
		end
	end

	-- FOV baixo só no modo economia (menos coisas renderizadas = menos calor)
	if _G.ModoAfkAtivado then
		camera.FieldOfView = 30
	end
end

local function ligarEconomia()
	if _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = true

	-- Esconde o cursor
	UserInputService.MouseIconEnabled = false

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)

	-- FPS alto SÓ agora (tela preta)
	pcall(function()
		setfpscap(FPS_AFK)
	end)

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BatterySaverAFK"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = uiParent

	background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BackgroundTransparency = 0
	background.BorderSizePixel = 0
	background.Active = true
	background.Parent = screenGui

	aplicarOtimizacoesPesadas()
end

local function desligarEconomia()
	if not _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = false

	UserInputService.MouseIconEnabled = true

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)

	-- Volta o FPS para o normal
	pcall(function()
		setfpscap(FPS_NORMAL)
	end)

	-- Restaura FOV padrão
	camera.FieldOfView = 70

	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end

	ultimoMovimento = tick()

	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		ultimaPosicao = character.HumanoidRootPart.Position
	end
	ultimoLookVector = camera.CFrame.LookVector
end

-- 5 cliques rápidos para sair
UserInputService.InputBegan:Connect(function(input)
	if not _G.ModoAfkAtivado then return end

	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		local tempoAtual = tick()

		if tempoAtual - tempoUltimoToque > 1.5 then
			toques = 0
		end

		toques = toques + 1
		tempoUltimoToque = tempoAtual

		if toques >= cliquesParaSair then
			toques = 0
			desligarEconomia()
		end
	end
end)

-- Loop principal
task.spawn(function()
	while true do
		task.wait(1)

		if _G.ModoAfkAtivado then
			UserInputService.MouseIconEnabled = false
		end

		local mudouFisica = false
		local character = player.Character

		if character and character:FindFirstChild("HumanoidRootPart") then
			local posAtual = character.HumanoidRootPart.Position
			if (posAtual - ultimaPosicao).Magnitude > 0.1 then
				mudouFisica = true
				ultimaPosicao = posAtual
			end
		end

		local lookAtual = camera.CFrame.LookVector
		if (lookAtual - ultimoLookVector).Magnitude > 0.05 then
			mudouFisica = true
			ultimoLookVector = lookAtual
		end

		if mudouFisica then
			if not _G.ModoAfkAtivado then
				ultimoMovimento = tick()
			end
		else
			if not _G.ModoAfkAtivado and (tick() - ultimoMovimento) >= TEMPO_STANDBY then
				ligarEconomia()
			end
		end

		-- Reaplica otimizações enquanto estiver no modo
		if _G.ModoAfkAtivado then
			aplicarOtimizacoesPesadas()
		end
	end
end)

-- Otimiza objetos que spawnarem durante o AFK
Workspace.DescendantAdded:Connect(function(obj)
	if not _G.ModoAfkAtivado then return end

	if obj:IsA("BasePart") then
		obj.Material = Enum.Material.SmoothPlastic
		obj.Reflectance = 0
		obj.CastShadow = false

		if obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
			obj.RenderFidelity = Enum.RenderFidelity.Performance
		end
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		obj.Transparency = 1
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
		or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
		obj.Enabled = false
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
		obj.Enabled = false
	elseif obj:IsA("Sound") then
		obj.Volume = 0
		obj:Stop()
	end
end)
