local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local uiParent = pcall(function() return CoreGui.Name end) and CoreGui or player:WaitForChild("PlayerGui")

if uiParent:FindFirstChild("BatterySaverAFK") then
	uiParent.BatterySaverAFK:Destroy()
end

-- ==================== CONFIG ====================
local CLIQUES_PARA_SAIR = 5
local TEMPO_RESET_CLIQUES = 2.5
local FPS_AFK = 10
local FPS_NORMAL = 120
-- ================================================

_G.ModoAfkAtivado = false
local toques = 0
local tempoUltimoToque = 0
local screenGui = nil
local clickConnection = nil

-- Guarda valores originais para restaurar
local originais = {
	QualityLevel = nil,
	FOV = 70,
	GlobalShadows = Lighting.GlobalShadows,
	Brightness = Lighting.Brightness,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local function esconderInfiniteYield()
	pcall(function()
		for _, gui in pairs(CoreGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				local name = string.lower(gui.Name)
				if name:find("infinite") or name:find("iy") or name:find("yield") then
					gui.Enabled = false
				end
			end
		end
		for _, gui in pairs(player.PlayerGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				local name = string.lower(gui.Name)
				if name:find("infinite") or name:find("iy") or name:find("yield") then
					gui.Enabled = false
				end
			end
		end
	end)
end

local function mostrarInfiniteYield()
	pcall(function()
		for _, gui in pairs(CoreGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				local name = string.lower(gui.Name)
				if name:find("infinite") or name:find("iy") or name:find("yield") then
					gui.Enabled = true
				end
			end
		end
		for _, gui in pairs(player.PlayerGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				local name = string.lower(gui.Name)
				if name:find("infinite") or name:find("iy") or name:find("yield") then
					gui.Enabled = true
				end
			end
		end
	end)
end

local function aplicarOtimizacoes()
	pcall(function()
		originais.QualityLevel = settings().Rendering.QualityLevel
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	pcall(function()
		setfpscap(FPS_AFK)
	end)

	originais.FOV = camera.FieldOfView
	camera.FieldOfView = 30

	-- Só reduz, NÃO destrói
	Lighting.GlobalShadows = false
	Lighting.Brightness = 0
	Lighting.Ambient = Color3.new(0, 0, 0)
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)

	-- Silencia sons (sem destruir)
	for _, som in pairs(SoundService:GetDescendants()) do
		if som:IsA("Sound") then
			som.Volume = 0
		end
	end

	esconderInfiniteYield()
end

local function restaurarTudo()
	pcall(function()
		if originais.QualityLevel then
			settings().Rendering.QualityLevel = originais.QualityLevel
		else
			settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
		end
	end)

	pcall(function()
		setfpscap(FPS_NORMAL)
	end)

	camera.FieldOfView = originais.FOV or 70

	Lighting.GlobalShadows = originais.GlobalShadows
	Lighting.Brightness = originais.Brightness
	Lighting.Ambient = originais.Ambient
	Lighting.OutdoorAmbient = originais.OutdoorAmbient

	mostrarInfiniteYield()
end

local function desligarEconomia()
	if not _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = false

	UserInputService.MouseIconEnabled = true

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
	end)

	if clickConnection then
		clickConnection:Disconnect()
		clickConnection = nil
	end

	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end

	toques = 0
	restaurarTudo()
end

local function ligarEconomia()
	if _G.ModoAfkAtivado then return end
	_G.ModoAfkAtivado = true

	UserInputService.MouseIconEnabled = false

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)

	-- Tela preta
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BatterySaverAFK"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = uiParent

	local background = Instance.new("Frame")
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BackgroundTransparency = 0
	background.BorderSizePixel = 0
	background.Active = true
	background.Parent = screenGui

	-- 5 cliques para desativar
	toques = 0
	tempoUltimoToque = 0

	clickConnection = background.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			local agora = tick()

			if agora - tempoUltimoToque > TEMPO_RESET_CLIQUES then
				toques = 0
			end

			toques = toques + 1
			tempoUltimoToque = agora

			if toques >= CLIQUES_PARA_SAIR then
				desligarEconomia()
			end
		end
	end)

	aplicarOtimizacoes()
end

-- Ativar pelo chat: !antilag
player.Chatted:Connect(function(msg)
	if string.lower(msg) == "!antilag" then
		if not _G.ModoAfkAtivado then
			ligarEconomia()
		end
	end
end)

-- Mantém mouse escondido enquanto ativo
task.spawn(function()
	while true do
		task.wait(1)
		if _G.ModoAfkAtivado then
			UserInputService.MouseIconEnabled = false
			esconderInfiniteYield()
		end
	end
end)
