-- ====================== EGG PURCHASE ======================
-- O dump oficial usa somente: Buy Egg(eggId, amountNumber).
-- Nunca envia booleans nem uma segunda/terceira chamada para o mesmo ciclo.
local HatchRequestBusy = false
local HatchAmountsCache = {}
local HatchAmountsCacheAt = {}

local function getAllowedHatchAmounts(eggName)
    local now = os.clock()
    if HatchAmountsCache[eggName] and now - (HatchAmountsCacheAt[eggName] or 0) < 3 then
        return HatchAmountsCache[eggName]
    end
    local amounts = {}
    local seen = {}
    pcall(function()
        local result = Network.Invoke("Eggs: Get Amounts", eggName)
        if type(result) == "table" then
            for _, value in ipairs(result) do
                local n = tonumber(value)
                if n and n >= 1 and not seen[n] then
                    seen[n] = true
                    table.insert(amounts, math.floor(n))
                end
            end
        end
    end)
    if #amounts == 0 then
        amounts = {1, 3, 8}
    end
    table.sort(amounts)
    HatchAmountsCache[eggName] = amounts
    HatchAmountsCacheAt[eggName] = now
    return amounts
end

local function chooseHatchAmount(eggName, requested)
    requested = math.max(1, math.floor(tonumber(requested) or 1))
    local allowed = getAllowedHatchAmounts(eggName)
    for _, amount in ipairs(allowed) do
        if amount == requested then return amount end
    end
    local selected = allowed[1] or 1
    for _, amount in ipairs(allowed) do
        if amount <= requested then selected = amount end
    end
    return selected
end

local function buyEggExact(eggName, requested)
    if not eggName or HatchRequestBusy then return false, 0 end
    local amount = chooseHatchAmount(eggName, requested)
    HatchRequestBusy = true
    local ok, result, err = pcall(function()
        return Network.Invoke("Buy Egg", eggName, amount)
    end)
    HatchRequestBusy = false
    if not ok then return false, amount, result end
    if result == false then return false, amount, err end
    return true, amount, err
end

