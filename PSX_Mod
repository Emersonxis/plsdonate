        local n = petInfo.name
        if string.find(n, "Huge") or string.find(n, "Domortuus Astra") or string.find(n, "Empyrean Agony") then
            return true
        end
    end
    return false
end

local function formatNumber(n)
    local absN = math.abs(n or 0)
    if absN >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif absN >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif absN >= 1e3 then
        return string.format("%.2fK", n / 1e3)
    else
        return tostring(n or 0)
    end
end

