-- Server boosts: detecta a lista real da build (nao depende de quantidade fixa).
local AutoServerBoosts = false
local function getServerBoostNames()
    local names, seen = {}, {}
    local function add(v)
        if type(v) ~= "string" or v == "" or seen[v] then return end
        seen[v] = true; table.insert(names, v)
    end
    pcall(function()
        local info = Library.Shared and Library.Shared.ServerBoostsInfo
        if type(info) == "table" then
            for k, v in pairs(info) do
                if type(k) == "string" then add(k) end
                if type(v) == "string" then add(v) end
                if type(v) == "table" then add(v.name or v.Name or v.id or v.Id) end
            end
        end
    end)
    -- fallback desta build: tres boosters de servidor conhecidos.
    if #names == 0 then
        for _, n in ipairs({"Triple Coins", "Triple Damage", "Super Lucky"}) do add(n) end
    end
    table.sort(names)
    return names
end

local function activeBoostSet(active)
    local set = {}
    if type(active) ~= "table" then return set end
    for k, v in pairs(active) do
        if type(k) == "string" then set[k:lower()] = true end
        if type(v) == "string" then set[v:lower()] = true end
        if type(v) == "table" then
            local n = v.name or v.Name or v.id or v.Id or v.boost or v.Boost
            if n then set[tostring(n):lower()] = true end
        end
    end
    return set
end

local function activateMissingServerBoosts()
    local names = getServerBoostNames()
    local active = {}
    pcall(function()
        if Library.ServerBoosts and Library.ServerBoosts.GetActiveBoosts then
            active = activeBoostSet(Library.ServerBoosts.GetActiveBoosts() or {})
        end
    end)
    local attempted = 0
    for _, name in ipairs(names) do
        if not active[name:lower()] then
            attempted = attempted + 1
            local fired = pcall(function()
                Network.Fire("Activate Server Boost", name)
            end)
            if not fired then
                pcall(function()
                    Network.Invoke("Activate Server Boost", name)
                end)
            end
            task.wait(0.15)
        end
    end
    return #names, attempted
end

