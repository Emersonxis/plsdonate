-- Monta lista real a partir do Directory + ServerCoins (nao fica so na lista fixa)
local DynamicBreakables = {}
local DynamicBreakablesSet = {}

local function isProbablyAreaOrJunk(name)
    if not name or name == "" then return true end
    local n = tostring(name):lower()
    -- filtra nomes de areas / mundos que vazam no dump
    local junk = {
        "spawn", "world", "front", "vip", "town", "forest", "beach", "mine",
        "winter", "glacier", "desert", "volcano", "area", "island gate",
    }
    -- se for so uma area generica sem chest/pile/block etc, ignora
    local hasBreakableWord = n:find("chest") or n:find("pile") or n:find("block")
        or n:find("present") or n:find("crate") or n:find("vault") or n:find("safe")
        or n:find("diamond") or n:find("coin") or n:find("orb") or n:find("egg")
        or n:find("cube") or n:find("cane") or n:find("pumpkin") or n:find("relic")
    if not hasBreakableWord then
        for _, j in ipairs(junk) do
            if n == j or n:find("^" .. j) then return true end
        end
    end
    return false
end

local function addDynamicBreakable(name)
    if not name then return end
    name = tostring(name):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" or DynamicBreakablesSet[name] then return end
    if isProbablyAreaOrJunk(name) then return end
    DynamicBreakablesSet[name] = true
    table.insert(DynamicBreakables, name)
end

local function refreshDynamicBreakables()
    DynamicBreakables = {}
    DynamicBreakablesSet = {}
    -- seed com priorityList (eventos / highs)
    for _, n in ipairs(priorityList) do
        addDynamicBreakable(n)
    end
    -- Directory.Coins: fonte principal, sem depender de dump externo.
    pcall(function()
        for name, data in pairs(Library.Directory.Coins or {}) do
            if type(name) == "string" then addDynamicBreakable(name) end
            if type(data) == "table" then
                addDynamicBreakable(data.name or data.Name or data.displayName or data.n)
                addDynamicBreakable(data.id or data.Id)
            end
        end
    end)
    -- ServerCoins vivos: inclui breakables adicionados por eventos/updates.
    for _, coin in pairs(ServerCoins or {}) do
        if type(coin) == "table" then
            addDynamicBreakable(coin.n or coin.name or coin.Name or coin.displayName)
        end
    end
    DynamicBreakables = sortByWorld(DynamicBreakables)
    return DynamicBreakables
end

local function makeUniqueBreakableOptions(list, includeCategories)
