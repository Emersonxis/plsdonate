local function buildEggOptions(world, mode)
    local base = EggsByWorld[world] or {}
    local opts = {}
    -- Prefer eggs that exist no Directory do jogo
    local dir = {}
    pcall(function()
        for name, _ in pairs(Egg_Directory) do
            dir[name] = true
        end
    end)
    for _, egg in ipairs(base) do
        local name = (mode == "Golden") and ("Golden " .. egg) or egg
        if next(dir) == nil or dir[name] or dir[egg] then
            table.insert(opts, name)
        end
    end
    -- Se Directory tiver eggs extras do mundo, inclui
    for name, _ in pairs(dir) do
        if mode == "Golden" then
            if name:find("Golden ") and not table.find(opts, name) then
                -- skip auto-add all golden; keep list focused
            end
        end
    end
    if #opts == 0 then
        -- fallback: tudo do Directory filtrando golden
        for name, _ in pairs(dir) do
            local isG = name:find("Golden ") ~= nil
            if (mode == "Golden" and isG) or (mode ~= "Golden" and not isG) then
                table.insert(opts, name)
            end
        end
        table.sort(opts)
    end
    return opts
end

