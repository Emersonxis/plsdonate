local function directoryWorldRank(areaName)
    local result = nil
    pcall(function()
        local area = Library and Library.Directory and Library.Directory.Areas
            and Library.Directory.Areas[areaName]
        local worlds = Library and Library.Directory and Library.Directory.Worlds
        local world = area and worlds and worlds[area.world]
        if world and tonumber(world.worldOrder) then
            result = tonumber(world.worldOrder)
        end
    end)
    return result
end

local function worldRank(name)
    name = tostring(name or "")
    local direct = directoryWorldRank(name)
    if direct then return direct end
    local low = name:lower()
    for i, w in ipairs(WORLD_ORDER) do
        if low:find(w:lower(), 1, true) then return 10000 + i end
    end
    if low:find("giant") or low:find("super chest") or low:find("easter")
        or low:find("diamond") or low:find("candy canes") then
        return 0
    end
    return 20000
end

local function sortByWorld(list)
    local t = {}
    for _, v in ipairs(list or {}) do table.insert(t, v) end
    table.sort(t, function(a, b)
        local ra, rb = worldRank(a), worldRank(b)
        if ra ~= rb then return ra < rb end
        return tostring(a):lower() < tostring(b):lower()
    end)
    return t
end

