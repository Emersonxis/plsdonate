                local tier = def.tiers[tonumber(tierIdx) or tierIdx]
                title = (tier and tier.title) or def.title
            end
            title = title or pow.title or pow.Title or pow.name or pow.Name
        end)
        if title then
            for _, want in ipairs(SelectedEnchantTitles) do
                local t = string.lower(tostring(title))
                local w = string.lower(tostring(want))
                if t == w or t:find(w, 1, true) then return true end
