local function setPlayerGuiEnabled(name, state)
    -- Protecao importante: a aba GUIs nunca desativa interfaces.
    -- O Rayfield pode chamar callbacks com false ao carregar a configuracao;
    -- esse caso deve ser ignorado para nao quebrar o jogo.
    if state ~= true then
        return false
    end
    local lp = Players.LocalPlayer
    if not lp then return false end
    local pg = lp:FindFirstChild("PlayerGui") or PlayerGui
    if not pg then return false end
    local gui = pg:FindFirstChild(name)
    if gui then
        pcall(function()
            if gui:IsA("ScreenGui") or gui:IsA("BillboardGui") or gui:IsA("GuiMain") then
                gui.Enabled = state
            elseif gui:IsA("LayerCollector") then
                gui.Enabled = state
            else
                -- alguns sao Folders; tenta Enabled mesmo assim
                gui.Enabled = state
            end
        end)
        return true
    end
    pcall(function()
        if Library.GUI and Library.GUI[name] and Library.GUI[name].Gui then
            Library.GUI[name].Gui.Enabled = state
        end
    end)
    for _, child in ipairs(pg:GetChildren()) do
        if child.Name:lower() == tostring(name):lower() then
            pcall(function() child.Enabled = state end)
            return true
        end
    end
    return false
end

local function listAllPlayerGuis()
    local names = {}
    local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return names end
    for _, child in ipairs(pg:GetChildren()) do
        -- lista ScreenGui / LayerCollector e tambem frames raiz comuns
        if child:IsA("ScreenGui") or child:IsA("BillboardGui") or child:IsA("LayerCollector") then
            table.insert(names, child.Name)
        elseif child:IsA("Folder") or child:IsA("GuiObject") then
            -- ainda inclui se tiver Enabled (muitos hubs usam)
            local ok = pcall(function()
                local _ = child.Enabled
            end)
            if ok then
                table.insert(names, child.Name)
            end
        end
    end
    table.sort(names)
    return names
end

