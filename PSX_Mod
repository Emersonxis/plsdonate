local function resolvePetCmds()
    if Library.Client and Library.Client.PetCmds then return Library.Client.PetCmds end
    if Library.PetCmds then return Library.PetCmds end
    local roots = {}
    if ReplicatedStorage:FindFirstChild("Framework") then table.insert(roots, ReplicatedStorage.Framework) end
    if ReplicatedStorage:FindFirstChild("Library") then table.insert(roots, ReplicatedStorage.Library) end
    for _, root in ipairs(roots) do
        local client = root:FindFirstChild("Client") or (root:FindFirstChild("Library") and root.Library:FindFirstChild("Client"))
        if client and client:FindFirstChild("PetCmds") then
            local ok, mod = pcall(require, client.PetCmds)
            if ok then return mod end
        end
    end
    return { GetEquipped = function() return {} end, Get = function() return nil end }
end
