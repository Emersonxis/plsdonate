local function requiredVariantNums(targetVariant)
    local maxV = variantToNum[targetVariant] or 1
    local t = {}
    for i = 1, maxV do t[i] = i end
    return t
end

local function collectionSet()
    refreshData()
    local owned = {}
    local col = (Data and Data.Collection) or {}
    for _, key in ipairs(col) do
        owned[tostring(key)] = true
    end
    return owned
end

local function hasCollection(owned, petId, vNum)
    return owned[tostring(petId) .. "-" .. tostring(vNum)] == true
end

local function getEggDrops(eggName)
    local ids = {}
    local seen = {}
    pcall(function()
        local dir = Library.Directory.Eggs or {}
        local eggData = dir[eggName]
        if not eggData then return end
        local drops = eggData.drops
        if type(drops) == "string" and dir[drops] then
            drops = dir[drops].drops
        end
        if type(drops) == "table" then
            for _, entry in ipairs(drops) do
                local pid = type(entry) == "table" and (entry[1] or entry.id or entry.petId) or entry
                if pid and not seen[tostring(pid)] then
                    -- pula Secret no index automatico (odds ??)
                    local pet = Library.Directory.Pets[tostring(pid)]
                    if pet and pet.rarity == "Secret" then
                        continue
                    end
                    seen[tostring(pid)] = true
                    table.insert(ids, tostring(pid))
                end
            end
        end
    end)
    return ids
end

local function getEggCost(eggName)
    local cost = math.huge
    pcall(function()
        if Library.Economy and Library.Economy.EggCost then
            cost = tonumber(Library.Economy.EggCost(eggName, Library.Directory.Eggs[eggName])) or cost
        end
    end)
    pcall(function()
        local ed = Library.Directory.Eggs[eggName]
        if ed then
            cost = tonumber(ed.cost or ed.price or ed.Price or cost) or cost
        end
    end)
    if cost == math.huge then cost = 999999999 end
    return cost
end

local function petRarityAllowed(petId)
    if #IndexRarities == 0 then return true end
    local ok = false
    pcall(function()
        local dir = Library.Directory.Pets[tostring(petId)]
        if not dir then ok = true return end
        local r = tostring(dir.rarity or "")
        -- Basic ~ Common
        for _, allowed in ipairs(IndexRarities) do
            local a = tostring(allowed)
            if r:lower() == a:lower() then ok = true return end
            if a:lower() == "basic" and (r:lower() == "common" or r:lower() == "basic") then ok = true return end
        end
    end)
    return ok
end

local function isBlacklistedPet(petId)
    local name = tostring(petId)
    pcall(function()
        local dir = Library.Directory.Pets[tostring(petId)]
        if dir and dir.name then name = dir.name end
    end)
    local n = string.lower(name)
    for _, b in ipairs(IndexBlacklist) do
        if n:find(string.lower(tostring(b)), 1, true) then return true end
    end
    return false
end

local function eggNormalsDone(eggName, maxV)
    -- true se TODOS os pets relevantes ja tem normal no index
    -- e ainda falta alguma variante > 1
    if maxV <= 1 then return false end
    local drops = getEggDrops(eggName)
    if #drops == 0 then return false end
    local owned = collectionSet()
    local anyNeedHigher = false
    for _, pid in ipairs(drops) do
        if isBlacklistedPet(pid) or not petRarityAllowed(pid) then continue end
        if not hasCollection(owned, pid, 1) then
            return false -- ainda falta normal
        end
        for v = 2, maxV do
            if not hasCollection(owned, pid, v) then
                anyNeedHigher = true
            end
        end
    end
    return anyNeedHigher
end

local function eggsForSelectedWorlds()
    local list = {}
    local seen = {}
    local maxV = variantToNum[CollectionVariant] or 1
    for _, world in ipairs(IndexWorlds) do
        local bases = IndexWorldEggMap[world] or {}
        for _, base in ipairs(bases) do
            local normalName = base
            local goldenName = "Golden " .. base
            -- se normal ja completo e precisa gold+, prefere so Golden egg
            local preferGolden = eggNormalsDone(normalName, maxV)
            local candidates = {}
            if preferGolden then
                candidates = { goldenName, normalName } -- golden primeiro
            elseif maxV == 1 then
                candidates = { normalName } -- so normal
            else
                candidates = { normalName, goldenName }
            end
            for _, name in ipairs(candidates) do
                if not seen[name] then
                    seen[name] = true
                    table.insert(list, name)
                end
            end
        end
    end
    table.sort(list, function(a, b)
        -- golden preferido sobe na prioridade se normals done
        local aGold = string.lower(a):find("golden", 1, true) ~= nil
        local bGold = string.lower(b):find("golden", 1, true) ~= nil
        local aBase = a:gsub("^Golden ", "")
        local bBase = b:gsub("^Golden ", "")
        if aBase == bBase and aGold ~= bGold then
            -- se normals do base estao done, golden antes
            if eggNormalsDone(aBase, maxV) then
                return aGold -- golden first
            end
        end
        return getEggCost(a) < getEggCost(b)
    end)
    return list
end

local function indexDeleteUids(uids)
    if not uids or #uids == 0 then return end
    -- safety: nunca manda locked
    local safe = {}
    refreshData()
    local byUid = {}
    for _, pet in pairs(Data.Pets or {}) do
        if pet.uid then byUid[pet.uid] = pet end
    end
    for _, uid in ipairs(uids) do
        local pet = byUid[uid]
        if pet and not isBlacklisted(pet.uid)
            and not isPetLocked(pet) and not isHugePet(pet.id) then
            table.insert(safe, uid)
        end
    end
    if #safe == 0 then return end
    pcall(function()
        Network.Invoke("Delete Several Pets", safe)
    end)
end

-- Craft Index: NAO usa normal→gold (prefere Golden Egg)
-- so gold→rainbow e rainbow→DM, shiny com shiny
local function indexCraftOnce()
    refreshData()
    local owned = collectionSet()
    local maxV = variantToNum[CollectionVariant] or 1
    local neededRain = math.max(1, RainbowPetsNeeded or 6)
    local neededDM = math.max(1, DarkMatterPetsNeeded or 1)

    local groups = {} -- key = id|S/N -> { gold={}, rainbow={} }
    for _, pet in pairs(Data.Pets or {}) do
        if isBlacklisted(pet.uid) or isPetLocked(pet) or isHugePet(pet.id) then continue end
        local key = tostring(pet.id) .. (isPetShiny(pet) and "|S" or "|N")
        groups[key] = groups[key] or { id = pet.id, gold = {}, rainbow = {} }
        if pet.dm then
            -- ok
        elseif pet.r then
            table.insert(groups[key].rainbow, pet.uid)
        elseif pet.g then
            table.insert(groups[key].gold, pet.uid)
        end
        -- normals ignorados pro craft (Golden Egg e o caminho)
    end

    for _, g in pairs(groups) do
        local petId = g.id
        if isBlacklistedPet(petId) or not petRarityAllowed(petId) then continue end
        if maxV >= 3 and not hasCollection(owned, petId, 3) then
            while #g.gold >= neededRain do
                local batch = {}
                for i = 1, neededRain do table.insert(batch, table.remove(g.gold, 1)) end
                pcall(function() Network.Invoke("Use Rainbow Machine", batch) end)
                task.wait(0.35)
                refreshData()
                owned = collectionSet()
                if hasCollection(owned, petId, 3) then break end
            end
        end
        if maxV >= 4 and not hasCollection(owned, petId, 4) then
            while #g.rainbow >= neededDM do
                local batch = {}
                for i = 1, neededDM do table.insert(batch, table.remove(g.rainbow, 1)) end
                pcall(function() Network.Invoke("Convert To Dark Matter", batch) end)
                task.wait(0.4)
                pcall(function()
                    local save = Library.Save.Get()
                    if save and type(save.DarkMatterQueue) == "table" then
                        for slotId, _ in pairs(save.DarkMatterQueue) do
                            pcall(function() Network.Invoke("Redeem Dark Matter Pet", slotId) end)
                            pcall(function() Network.Invoke("Prompt Dark Matter Skip", slotId) end)
                        end
                    end
                end)
                refreshData()
                owned = collectionSet()
                if hasCollection(owned, petId, 4) then break end
            end
        end
    end
end

-- Delete: se ja tem a variante ALVO no index → apaga todas as versoes do pet (menos locked)
-- se ainda falta alvo: guarda gold/rainbow pra craft (normals nao importam)
local function indexCleanupEggPets(petIds, maxV)
    refreshData()
    local owned = collectionSet()
    local neededRain = math.max(1, RainbowPetsNeeded or 6)
    local neededDM = math.max(1, DarkMatterPetsNeeded or 1)

    local eggSet = {}
    for _, id in ipairs(petIds) do eggSet[tostring(id)] = true end

    local keepGold, keepRain = {}, {} -- pid -> qty
    for pid, _ in pairs(eggSet) do
        if hasCollection(owned, pid, maxV) then
            keepGold[pid] = 0
            keepRain[pid] = 0
        else
            keepGold[pid] = 0
            keepRain[pid] = 0
            if maxV >= 3 and not hasCollection(owned, pid, 3) then
                keepGold[pid] = neededRain
            end
            if maxV >= 4 and not hasCollection(owned, pid, 4) then
                keepRain[pid] = neededDM
                if not hasCollection(owned, pid, 3) then
                    keepGold[pid] = math.max(keepGold[pid], neededRain)
                end
            end
        end
    end

    local goldBuckets, rainBuckets = {}, {}
    local toDelete = {}
    for _, pet in pairs(Data.Pets or {}) do
        if isBlacklisted(pet.uid) or isPetLocked(pet) or isHugePet(pet.id) then continue end
        local pid = tostring(pet.id)
        if not eggSet[pid] then continue end

        if hasCollection(owned, pid, maxV) then
            -- alvo ja no index: deleta normal/gold/rainbow/dm desse pet
            table.insert(toDelete, pet.uid)
        elseif pet.dm then
            -- DM ainda nao contou no index? mantem
        elseif pet.r then
            rainBuckets[pid] = rainBuckets[pid] or {}
            table.insert(rainBuckets[pid], pet.uid)
        elseif pet.g then
            goldBuckets[pid] = goldBuckets[pid] or {}
            table.insert(goldBuckets[pid], pet.uid)
        else
            -- normal: sempre pode deletar (Golden Egg e o caminho)
            table.insert(toDelete, pet.uid)
        end
    end

    for pid, list in pairs(goldBuckets) do
        local reserve = keepGold[pid] or 0
        for i = reserve + 1, #list do
            table.insert(toDelete, list[i])
        end
    end
    for pid, list in pairs(rainBuckets) do
        local reserve = keepRain[pid] or 0
        for i = reserve + 1, #list do
            table.insert(toDelete, list[i])
        end
    end

    if #toDelete > 0 then
        indexDeleteUids(toDelete)
    end
end

local function eggNeedsWork(eggName, maxV)
    local drops = getEggDrops(eggName)
    if #drops == 0 then return false, drops end
    local owned = collectionSet()
    for _, pid in ipairs(drops) do
        if isBlacklistedPet(pid) or not petRarityAllowed(pid) then continue end
        for v = 1, maxV do
            if not hasCollection(owned, pid, v) then
                return true, drops
            end
        end
    end
    return false, drops
end

