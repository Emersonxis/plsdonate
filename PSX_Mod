-- Detecta o caminho correto do Library uma vez (Framework ou legado)
local function resolveLibrary()
    local candidates = {
        function()
            local fw = ReplicatedStorage:FindFirstChild("Framework") or ReplicatedStorage:WaitForChild("Framework", 8)
            if not fw then return nil end
            local mod = fw:FindFirstChild("Library") or fw:WaitForChild("Library", 8)
            if mod then return require(mod), "ReplicatedStorage.Framework.Library" end
        end,
        function()
            local mod = ReplicatedStorage:FindFirstChild("Library") or ReplicatedStorage:WaitForChild("Library", 3)
            if mod and mod:IsA("ModuleScript") then
                return require(mod), "ReplicatedStorage.Library"
            end
        end,
        function()
            -- alguns forks: ReplicatedStorage.Modules.Library
            local mods = ReplicatedStorage:FindFirstChild("Modules")
            if mods then
                local mod = mods:FindFirstChild("Library")
                if mod then return require(mod), "ReplicatedStorage.Modules.Library" end
            end
        end,
    }
    for _, try in ipairs(candidates) do
        local ok, lib, path = pcall(function()
            local a, b = try()
            return a, b
        end)
        if ok and lib then
            return lib, path
        end
    end
    error("[PSX Mod Hub] Nao foi possivel achar Library. Espere o jogo carregar e execute de novo.")
end

