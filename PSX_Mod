    if lower:find("area") and not lower:find("chest") then return false end
    if lower:find("giant") then return true end
    if lower:find("super chest") then return true end
    if lower:find("ancient") and lower:find("chest") then return true end
    if lower:find("enchanted") and lower:find("chest") then return true end
    if lower:find("throne") and lower:find("chest") then return true end
    if lower:find("relic") and lower:find("chest") then return true end
    if lower:find("heaven") and lower:find("chest") then return true end
    if lower:find("hell") and lower:find("chest") then return true end
    if lower:find("haunted") and lower:find("chest") then return true end
    if lower:find("magma") and lower:find("chest") then return true end
    if lower:find("deep ocean") and (lower:find("chest") or lower:find("vault")) then return true end
