-- ====================== VIP REJOIN + BALLOON WORLD LOOP ======================
local TeleportService = game:GetService("TeleportService")

local function extractVipCode(text)
    if not text or text == "" then return nil end
    text = tostring(text):gsub("%s+", "")
    local code = text:match("[?&]code=([%w%-]+)")
        or text:match("privateServerLinkCode=([%w%-]+)")
        or text:match("share_links%?code=([%w%-]+)")
    if code then return code end
    if text:match("^[%w%-]+$") and #text >= 8 then return text end
    return nil
end

local function setVipFromText(text)
    local code = extractVipCode(text)
    if code then
        BalloonVipCode = code
        if tostring(text):find("http") then
            BalloonVipLink = text
        else
            BalloonVipLink = "https://www.roblox.com/share?code=" .. code .. "&type=Server"
        end
        return code
    end
    return nil
end

-- tenta varios metodos: share code / private / deeplink
local function rejoinVipServer()
    local code = BalloonVipCode
    if (not code or code == "") and BalloonVipLink then
        code = extractVipCode(BalloonVipLink)
        BalloonVipCode = code
    end
    if not code or code == "" then
        warn("[VIP] Nenhum codigo VIP salvo")
        return false
    end
    local lp = player
    local placeId = game.PlaceId
    BalloonStatus = "rejoining VIP"
    print("[VIP] Rejoin code=", code, "place=", placeId)

    -- 1) TeleportToPrivateServer (access code classico)
    local ok1 = pcall(function()
        TeleportService:TeleportToPrivateServer(placeId, code, {lp})
    end)
    if ok1 then return true end

    -- 2) TeleportAsync + ReservedServerAccessCode
    local ok2 = pcall(function()
        local opts = Instance.new("TeleportOptions")
        pcall(function() opts.ReservedServerAccessCode = code end)
        pcall(function() opts:SetTeleportData({ vipCode = code }) end)
        TeleportService:TeleportAsync(placeId, {lp}, opts)
    end)
    if ok2 then return true end

    -- 3) Deeplink share (alguns executors abrem)
    local deep = "roblox://navigation/share_links?code=" .. code .. "&type=Server"
    local ok3 = pcall(function()
        if typeof(request) == "function" then
            request({ Url = BalloonVipLink or deep, Method = "GET" })
        elseif syn and syn.request then
            syn.request({ Url = BalloonVipLink or deep, Method = "GET" })
        end
    end)
    pcall(function()
        if setclipboard then setclipboard(BalloonVipLink or deep) end
        if toclipboard then toclipboard(BalloonVipLink or deep) end
    end)
    print("[VIP] Fallback: link copiado. Cole no browser se o teleport falhar:", BalloonVipLink or deep)
    notify("VIP", "Teleport falhou — link copiado", 5)
    return ok3
end

local function isBalloonCoin(coin)
    if type(coin) ~= "table" then return false end
    local n = tostring(coin.n or coin.name or coin.Name or "")
    local f = tostring(BalloonNameFilter or "Balloon")
    if f == "" then f = "Balloon" end
    return n:lower():find(f:lower(), 1, true) ~= nil
end

local function listBalloonsInArea(areaName)
    local list = {}
    for id, coin in pairs(ServerCoins or {}) do
        if coin and coin.p and isBalloonCoin(coin) then
            if not areaName or coin.a == areaName then
                table.insert(list, {
                    id = id,
                    p = coin.p,
                    a = coin.a,
                    n = tostring(coin.n or ""),
                    distance = (HumanoidRootPart and (coin.p - HumanoidRootPart.Position).Magnitude) or 0,
                })
            end
        end
    end
    table.sort(list, function(a, b) return (a.distance or 0) < (b.distance or 0) end)
    return list
end

local function countBalloonsInArea(areaName)
    return #listBalloonsInArea(areaName)
end

local function farmBalloonsOnce(areaName)
    local equippedPets = getEquippedPets()
    if #equippedPets == 0 then return 0 end
    local balloons = listBalloonsInArea(areaName)
    if #balloons == 0 then return 0 end

    -- corta no Max Breakables
    while #balloons > math.max(1, MAX_BREAKABLES or 8) do
        table.remove(balloons)
    end

    -- puxa o player pro balloon mais perto (garante range)
    local nearest = balloons[1]
    if nearest and nearest.p and HumanoidRootPart then
        pcall(function()
            HumanoidRootPart.CFrame = CFrame.new(nearest.p + Vector3.new(0, 4, 0))
            if Safe_Part then
                Safe_Part.CFrame = CFrame.new(nearest.p) - Vector3.new(0, 5, 0)
            end
        end)
    end

    local byTarget = buildPetAssignments(equippedPets, balloons)
    fireFarmOnTargets(byTarget)
    return #balloons
end

local function waitAreaEmptyOfBalloons(areaName, timeout)
    local t0 = tick()
    timeout = timeout or 90
    while tick() - t0 < timeout do
        if not AutoBalloonLoop then return false end
        pcall(LoadAllCoinsInternal)
        if countBalloonsInArea(areaName) == 0 then
            task.wait(BalloonEmptyWait or 1.25)
            pcall(LoadAllCoinsInternal)
            if countBalloonsInArea(areaName) == 0 then
                return true
            end
        else
            farmBalloonsOnce(areaName)
        end
        task.wait(FarmSpeed or 0.15)
    end
    return countBalloonsInArea(areaName) == 0
end

local function goToArea(areaName)
    -- tenta achar qualquer coin/spawn da area pra teleportar
    for id, coin in pairs(ServerCoins or {}) do
        if coin and coin.p and coin.a == areaName then
            pcall(function()
                if HumanoidRootPart then
                    HumanoidRootPart.CFrame = CFrame.new(coin.p + Vector3.new(0, 5, 0))
                end
            end)
            return true
        end
    end
    -- fallback: Network travel (nomes comuns no PSX)
    local tried = false
    for _, remoteName in ipairs({
        "Travel to World", "Teleport to World", "Join World", "Change World",
        "WorldCmds:Teleport", "Teleport",
    }) do
        tried = pcall(function()
            Network.Invoke(remoteName, areaName)
        end) or tried
        tried = pcall(function()
            Network.Fire(remoteName, areaName)
        end) or tried
    end
    pcall(function()
        if Library.WorldCmds and Library.WorldCmds.Teleport then
            Library.WorldCmds.Teleport(areaName)
        end
    end)
    return tried
end

local function runBalloonWorldLoop()
    while AutoBalloonLoop do
        local areas = BalloonSelectedAreas
        if not areas or #areas == 0 then
            -- fallback: todas as areas conhecidas
            areas = AllGameAreas
        end
        if not areas or #areas == 0 then
            BalloonStatus = "sem areas"
            task.wait(2)
            continue
        end

        for _, areaName in ipairs(areas) do
            if not AutoBalloonLoop then break end
            BalloonStatus = "area: " .. tostring(areaName)
            print("[Balloon] Indo para", areaName)
            pcall(LoadAllCoinsInternal)
            goToArea(areaName)
            task.wait(0.6)
            pcall(LoadAllCoinsInternal)

            -- se nao tem balloon nessa area, pula
            if countBalloonsInArea(areaName) == 0 then
                print("[Balloon] Sem Balloon em", areaName, "— next")
                continue
            end

            BalloonStatus = "farmando: " .. tostring(areaName)
            waitAreaEmptyOfBalloons(areaName, 180)
            print("[Balloon] Area limpa:", areaName)
        end

        if not AutoBalloonLoop then break end

        -- loop de mundos completo → rejoin VIP pra resetar balloons
        BalloonStatus = "rejoin VIP"
        print("[Balloon] Loop completo — rejoin VIP para resetar spawns")
        notify("Balloon Loop", "Rejoin VIP (reset spawns)...", 4)
        local ok = rejoinVipServer()
        -- se teleportou, o script reinicia no load; se nao, espera e continua
        task.wait(math.max(1, BalloonRejoinDelay or 5))
        if ok then
            -- apos teleport o LocalScript reinicia; flag em getgenv pra auto-retomar
            pcall(function()
                getgenv()._PSX_AutoBalloonResume = true
                getgenv()._PSX_BalloonVipCode = BalloonVipCode
                getgenv()._PSX_BalloonAreas = BalloonSelectedAreas
                getgenv()._PSX_BalloonDelay = BalloonRejoinDelay
                getgenv()._PSX_BalloonFilter = BalloonNameFilter
            end)
        end
        BalloonStatus = "pos-rejoin wait"
        task.wait(0.5)
    end
    BalloonStatus = "idle"
end


-- ====================== FARM HELPERS ======================
local function coinHealth(coin)
    if type(coin) ~= "table" then return 0 end
    local h = coin.h or coin.hp or coin.health or coin.Health or coin.m or coin.maxHealth
    return tonumber(h) or 0
end

local function coinNameOf(coin)
    if type(coin) ~= "table" then return "" end
    return tostring(coin.n or coin.name or coin.Name or "")
end

local function matchesNameList(coinName, list)
    if not list or #list == 0 then return true end -- sem filtro = tudo
    local cn = tostring(coinName or ""):lower()
    if cn == "" then return false end
    for _, t in ipairs(list) do
        local tl = tostring(t):lower()
        if tl == "" then continue end
        if cn == tl or cn:find(tl, 1, true) or tl:find(cn, 1, true) then
            return true
        end
    end
    return false
end

-- Divide pets nos targets:
-- Spread: 22 pets em 5 breakables -> ~4-5 pets cada (Max rewards Fired em varios)
-- OnePerBreakable: 1 pet por breakable (ate Max Breakables)
local function buildPetAssignments(equippedPets, targets)
    local byTarget = {}
    if not equippedPets or #equippedPets == 0 or not targets or #targets == 0 then
        return byTarget
    end
    local limit = math.min(#targets, math.max(1, MAX_BREAKABLES or 1))
    if PetAssignMode == "OnePerBreakable" then
        local n = math.min(#equippedPets, limit)
        for i = 1, n do
            local tid = targets[i].id
            byTarget[tid] = { equippedPets[i] }
        end
    else
        -- Spread round-robin
        for i, petUID in ipairs(equippedPets) do
            local t = targets[((i - 1) % limit) + 1]
            if t then
                byTarget[t.id] = byTarget[t.id] or {}
                table.insert(byTarget[t.id], petUID)
            end
        end
    end
    return byTarget
end

local function fireFarmOnTargets(byTarget)
    for tid, pets in pairs(byTarget) do
        task.spawn(function()
            pcall(function()
                Network.Invoke("Join Coin", tid, pets)
            end)
            for _, petUID in ipairs(pets) do
                pcall(function()
                    Network.Fire("Change Pet Target", petUID, "Coin", tid)
                    Network.Fire("Farm Coin", tid, petUID)
                end)
            end
        end)
    end
end

local function sortTargetsNearest(list, origin)
    table.sort(list, function(a, b)
        local da = a.distance or ((a.p and origin) and (a.p - origin).Magnitude) or 0
        local db = b.distance or ((b.p and origin) and (b.p - origin).Magnitude) or 0
        return da < db
    end)
end

local function sortTargetsHealth(list, more)
    table.sort(list, function(a, b)
        if more then
            return (a.health or 0) > (b.health or 0)
        end
        return (a.health or 0) < (b.health or 0)
    end)
end

local function collectAreaTargets(areaName, method, priorityList, origin)
    local valid = {}
    for id, coin in pairs(ServerCoins or {}) do
        if coin and coin.p and coin.a == areaName then
            local cname = coinNameOf(coin)
            local ok = true
            if method == "Priority" then
                ok = matchesNameList(cname, priorityList)
            end
            if ok then
                local dist = origin and (coin.p - origin).Magnitude or 0
                table.insert(valid, {
                    id = id,
                    p = coin.p,
                    n = cname,
                    health = coinHealth(coin),
                    distance = dist,
                })
            end
        end
    end
    if method == "Nearest" then
        sortTargetsNearest(valid, origin)
    elseif method == "More Health" then
        sortTargetsHealth(valid, true)
    elseif method == "Less Health" then
        sortTargetsHealth(valid, false)
    elseif method == "Random" then
        -- shuffle leve
        for i = #valid, 2, -1 do
            local j = math.random(1, i)
            valid[i], valid[j] = valid[j], valid[i]
        end
    elseif method == "Priority" then
        -- prioridade: match primeiro, depois nearest
        sortTargetsNearest(valid, origin)
    end
    -- corta no Max Breakables (mantem os melhores ja ordenados)
    while #valid > math.max(1, MAX_BREAKABLES or 1) do
        table.remove(valid)
    end
    return valid
end

