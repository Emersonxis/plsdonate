Col_Tab:CreateToggle({
    name = "Auto Index (smart)",
    value = false,
    flag = "AutoIndex",
    callback = function(Value)
        AutoIndex = Value
        if not AutoIndex then return end
        task.spawn(function()
            while AutoIndex do
                local maxV = variantToNum[CollectionVariant] or 1
                local eggs = eggsForSelectedWorlds()
                local progressed = false
                for _, eggName in ipairs(eggs) do
                    if not AutoIndex then break end
                    -- Normal only: nao abre Golden egg
                    if maxV == 1 and string.lower(eggName):find("golden", 1, true) then
                        continue
                    end
                    -- Se normals do base ja estao no index e falta gold+, pula egg normal e usa Golden
                    local baseName = eggName:gsub("^Golden ", "")
                    local isGoldenEgg = string.lower(eggName):find("golden", 1, true) ~= nil
                    if maxV >= 2 and not isGoldenEgg and eggNormalsDone(baseName, maxV) then
                        continue
                    end
                    local needs, drops = eggNeedsWork(eggName, maxV)
                    if not needs then
                        -- egg completo: limpa inventario residual desse egg
                        if #drops > 0 then
                            indexCleanupEggPets(drops, maxV)
                        end
                        continue
                    end
                    progressed = true
                    -- fica NESSE egg ate completar a variante setada (Normal→…→DM)
                    local safety = 0
                    while AutoIndex and safety < 800 do
                        safety = safety + 1
                        needs, drops = eggNeedsWork(eggName, maxV)
                        if not needs then
                            indexCleanupEggPets(drops, maxV)
                            break
                        end
                        buyIndexEgg(eggName) -- usa HatchAmount da aba Hatching
                        task.wait(0.35)
                        indexCraftOnce()
                        indexCleanupEggPets(drops, maxV)
                        task.wait(0.2)
                    end
                end
                if not progressed then
                    task.wait(6)
                else
                    task.wait(1)
                end
            end
        end)
    end,
})

