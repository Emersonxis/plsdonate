                    if title and not seen[tostring(title)] then
                        seen[tostring(title)] = true
                        table.insert(titles, tostring(title))
                    end
                end
            end
        end
    end)
    if #titles == 0 then
        titles = {"Cartoon Coins I", "Cartoon Coins II", "Cartoon Coins III", "Cartoon Coins IV", "Cartoon Coins V"}
    end
    table.sort(titles, function(a, b) return a:lower() < b:lower() end)
    EnchantDeleteTitleOptions = titles
    return titles
end

function autoDeleteEnchantTitleMatches(pet, desiredTitle)
    if not pet or not desiredTitle or tostring(desiredTitle) == "" then return false end
    local powers = pet.powers or pet.Powers or pet.enchants or pet.Enchants
    if type(powers) ~= "table" then return false end
    local wanted = tostring(desiredTitle):lower()
    for _, power in pairs(powers) do
        local title
        pcall(function()
            local powerId = power[1] or power.id or power.Id or power.power or power.Power
            local tierId = power[2] or power.tier or power.Tier or power.level or power.Level
            local directoryPowers = Library.Directory and Library.Directory.Powers
            local definition = directoryPowers and (directoryPowers[powerId] or directoryPowers[tostring(powerId)])
            if definition and definition.tiers then
                local tier = definition.tiers[tonumber(tierId) or tierId]
                title = tier and (tier.title or tier.Title)
            end
            title = title or power.title or power.Title or power.name or power.Name
        end)
        if title and tostring(title):lower() == wanted then return true end
    end
    return false
end

function autoDeleteEnchantPetNameMatches(pet)
    if not pet or not SelectedEnchantDeletePet or SelectedEnchantDeletePet == "" then return false end
    local selected = tostring(SelectedEnchantDeletePet):lower()
    local candidates = {
        petDisplayName(pet.id),
        pet.name or pet.Name,
        pet.displayName or pet.DisplayName,
        ExclusivePetIdToName[tostring(pet.id)],
    }
    for _, candidate in ipairs(candidates) do
        if candidate and tostring(candidate):lower() == selected then return true end
    end
    return false
end

function autoDeleteEnchantCraftMatches(pet)
    if not pet or type(SelectedEnchantDeleteCrafts) ~= "table" or #SelectedEnchantDeleteCrafts == 0 then return false end
    local craft = tostring(getPetCraftVariant(pet) or ""):lower()
    for _, selectedCraft in ipairs(SelectedEnchantDeleteCrafts) do
        if craft == tostring(selectedCraft):lower() then return true end
    end
    return false
end

