        task.spawn(function()
            while AutoIndex do
                local maxV = variantToNum[CollectionVariant] or 1
                local eggs = eggsForSelectedWorlds()
                local progressed = false
                for _, eggName in ipairs(eggs) do
                    if not AutoIndex then break end
                    -- Normal only: nao abre Golden egg
                    if maxV == 1 and string.lower(eggName):find("golden", 1, true) then
                        continue
                    end
                    -- Se normals do base ja estao no index e falta gold+, pula egg normal e usa Golden
                    local baseName = eggName:gsub("^Golden ", "")
                    local isGoldenEgg = string.lower(eggName):find("golden", 1, true) ~= nil
                    if maxV >= 2 and not isGoldenEgg and eggNormalsDone(baseName, maxV) then
