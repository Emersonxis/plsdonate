local function getEquippedPets()
    local list, seen = {}, {}
    local function add(uid)
        if uid == nil then return end
        uid = tostring(uid)
        if uid ~= "" and not seen[uid] then
            seen[uid] = true
            table.insert(list, uid)
        end
    end
    local function consume(value)
        if type(value) ~= "table" then return end
        for key, petData in pairs(value) do
            if type(petData) == "table" then
                add(petData.uid or petData.UID)
            elseif type(petData) == "string" or type(petData) == "number" then
                add(petData)
            elseif petData == true and (type(key) == "string" or type(key) == "number") then
                add(key)
            end
        end
    end
    pcall(function() consume(PetCmds.GetEquipped(Library.LocalPlayer or player)) end)
    if #list == 0 then pcall(function() consume(PetCmds.GetEquipped()) end) end
    if #list == 0 then
        pcall(function()
            local save = Library.Save.Get()
            for _, pet in pairs((save and save.Pets) or {}) do
                if pet and (pet.e == true or pet.e == 1 or pet.equipped == true or pet.Equipped == true) then
                    add(pet.uid or pet.UID)
                end
            end
        end)
    end
    return list
end
