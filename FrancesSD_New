function applyCoinExplosionFXState(disabled)
    RemoveCoinExplosionFX = disabled == true

    pcall(function()
        local particles = Library and Library.Assets and Library.Assets.Particles
        local asset = particles and particles:FindFirstChild("Coin Explode")
        local damageAsset = particles and particles:FindFirstChild("Coin Damage")
        local bonusAsset = particles and particles:FindFirstChild("Coin Bonus")
        local specialParticles = particles and particles:FindFirstChild("Coin Special Bonuses")
        local other = Library and Library.Assets and Library.Assets.Other
        local specialOther = other and other:FindFirstChild("Coin Special Bonuses")

        if RemoveCoinExplosionFX then
            if asset and not CoinExplodeBackup then
                CoinExplodeBackup = asset:Clone()
                CoinExplodeParent = asset.Parent
                asset:Destroy()
                local empty = Instance.new("Folder")
                empty.Name = "Coin Explode"
                empty.Parent = CoinExplodeParent
            end
            if damageAsset and not CoinDamageBackup then
                CoinDamageBackup = damageAsset:Clone()
                CoinDamageParent = damageAsset.Parent
                damageAsset:Destroy()
                local emptyDamage = Instance.new("Folder")
                emptyDamage.Name = "Coin Damage"
                emptyDamage.Parent = CoinDamageParent
            end
            if bonusAsset and not CoinBonusBackup then
                CoinBonusBackup = bonusAsset:Clone()
                CoinBonusParent = bonusAsset.Parent
                bonusAsset:Destroy()
                local emptyBonus = Instance.new("Folder")
                emptyBonus.Name = "Coin Bonus"
                emptyBonus.Parent = CoinBonusParent
            end
            if specialParticles and not CoinSpecialParticlesBackup then
                CoinSpecialParticlesBackup = specialParticles:Clone()
                CoinSpecialParticlesParent = specialParticles.Parent
                specialParticles:Destroy()
                local emptySpecialParticles = Instance.new("Folder")
                emptySpecialParticles.Name = "Coin Special Bonuses"
                emptySpecialParticles.Parent = CoinSpecialParticlesParent
            end
            if specialOther and not CoinSpecialOtherBackup then
                CoinSpecialOtherBackup = specialOther:Clone()
                CoinSpecialOtherParent = specialOther.Parent
                specialOther:Destroy()
                local emptySpecialOther = Instance.new("Folder")
                emptySpecialOther.Name = "Coin Special Bonuses"
                emptySpecialOther.Parent = CoinSpecialOtherParent
            end
        elseif CoinExplodeBackup and CoinExplodeParent then
            local current = CoinExplodeParent:FindFirstChild("Coin Explode")
            if current then current:Destroy() end
            CoinExplodeBackup:Clone().Parent = CoinExplodeParent
            if CoinDamageBackup and CoinDamageParent then
                local currentDamage = CoinDamageParent:FindFirstChild("Coin Damage")
                if currentDamage then currentDamage:Destroy() end
                CoinDamageBackup:Clone().Parent = CoinDamageParent
            end
            if CoinBonusBackup and CoinBonusParent then
                local currentBonus = CoinBonusParent:FindFirstChild("Coin Bonus")
                if currentBonus then currentBonus:Destroy() end
                CoinBonusBackup:Clone().Parent = CoinBonusParent
            end
            if CoinSpecialParticlesBackup and CoinSpecialParticlesParent then
                local currentSpecialParticles = CoinSpecialParticlesParent:FindFirstChild("Coin Special Bonuses")
                if currentSpecialParticles then currentSpecialParticles:Destroy() end
                CoinSpecialParticlesBackup:Clone().Parent = CoinSpecialParticlesParent
            end
            if CoinSpecialOtherBackup and CoinSpecialOtherParent then
                local currentSpecialOther = CoinSpecialOtherParent:FindFirstChild("Coin Special Bonuses")
                if currentSpecialOther then currentSpecialOther:Destroy() end
                CoinSpecialOtherBackup:Clone().Parent = CoinSpecialOtherParent
            end
        end
    end)

    pcall(function()
        if CoinParticleConnection then
            CoinParticleConnection:Disconnect()
            CoinParticleConnection = nil
        end

        if not RemoveCoinExplosionFX then return end

        local function hideCoinParticle(obj)
            if not obj then return end
            local objectName = tostring(obj.Name)
            if objectName == "Coin Particle" or objectName == "Bonus Particle" then
                pcall(function()
                    if obj:IsA("BasePart") then
                        obj.LocalTransparencyModifier = 1
                        obj.Transparency = 1
                        obj.CanCollide = false
                        obj.CanTouch = false
                        obj.CanQuery = false
                        obj.CastShadow = false
                        obj.AssemblyLinearVelocity = Vector3.zero
                        obj.AssemblyAngularVelocity = Vector3.zero
                    end
                    for _, child in ipairs(obj:GetDescendants()) do
                        if child:IsA("ParticleEmitter") or child:IsA("Beam") or child:IsA("Trail") then
                            child.Enabled = false
                        end
                    end
                end)
            elseif objectName:find("SpecialBonusParticle", 1, true) then
                pcall(function() obj.Enabled = false end)
            elseif objectName:find("SpecialBonusText", 1, true) then
                pcall(function() obj.Visible = false end)
            elseif objectName == "BonusReward" then
                pcall(function()
                    if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then obj.Enabled = false end
                end)
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                pcall(function()
                    if tostring(obj.Text):upper():find("BONUS", 1, true) then obj.Visible = false end
                end)
            end
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            hideCoinParticle(obj)
        end

        CoinParticleConnection = Workspace.DescendantAdded:Connect(function(obj)
            if RemoveCoinExplosionFX then hideCoinParticle(obj) end
        end)
    end)
end

function applyBreakablesVisualState(hidden)
    pcall(function()
        local things = Workspace:FindFirstChild("__THINGS")
        local coins = things and things:FindFirstChild("Coins")
        if not coins then return end
        for _, obj in ipairs(coins:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = hidden and 1 or 0
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                obj.Enabled = not hidden
            end
        end
    end)
end

function applyParticleState(disabled)
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                if ParticleStates[obj] == nil then ParticleStates[obj] = obj.Enabled end
                obj.Enabled = disabled and false or ParticleStates[obj]
            end
        end
    end)
end

function applyMapState(hidden)
    pcall(function()
        local map = Workspace:FindFirstChild("__MAP")
        if not map then return end
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("BasePart") then
                if MapTransparencyStates[obj] == nil then
                    MapTransparencyStates[obj] = obj.Transparency
                end
                -- Mantém CanCollide intacto: o mapa pode ficar invisível,
                -- mas o player não cai no void ao sair do hoverboard.
                obj.Transparency = hidden and 1 or MapTransparencyStates[obj]
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                if MapTransparencyStates[obj] == nil then
                    MapTransparencyStates[obj] = obj.Transparency
                end
                obj.Transparency = hidden and 1 or MapTransparencyStates[obj]
            end
        end
    end)
end

