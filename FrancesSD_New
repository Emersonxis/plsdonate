function Balloon.List()
    local result = {}
    for id, coin in pairs(ServerCoins or {}) do
        local name = tostring(coin and (coin.n or coin.name or coin.Name) or "")
        if coin and coin.p and name:lower():find("balloon", 1, true) then
            table.insert(result, { id = id, position = coin.p })
        end
    end
    return result
end

function Balloon.FarmOnce()
    local pets = getEquippedPets()
    local balloons = Balloon.List()
    if #pets == 0 or #balloons == 0 then return #balloons end
    local maxTargets = math.min(#balloons, MAX_BREAKABLES or 8)
    for index, petUID in ipairs(pets) do
        local target = balloons[((index - 1) % maxTargets) + 1]
        if target then
            pcall(function()
                Network.Invoke("Join Coin", target.id, { petUID })
                Network.Fire("Change Pet Target", petUID, "Coin", target.id)
                farmCoinCompat(target.id, petUID)
            end)
        end
    end
    return #balloons
end

function Balloon.TravelToWorld(worldName)
    worldName = tostring(worldName or "")
    if worldName == "" or worldName == "Spawn World" then return true end
    local command = "Travel to the " .. worldName
    local ok = pcall(function()
        Network.Invoke(command)
    end)
    if not ok then
        ok = pcall(function()
            Network.Fire(command)
        end)
    end
    return ok
end

function Balloon.RejoinVip()
    local code = Balloon.CodeFromText(Balloon.VipLink)
    if not code then
        Balloon.Status = "VIP code invalido"
        return false
    end
    local ok = pcall(function()
        game:GetService("TeleportService"):TeleportToPrivateServer(game.PlaceId, code, { player })
    end)
    Balloon.Status = ok and "rejoining VIP" or "falha no rejoin"
    return ok
end

function Balloon.Run()
    task.spawn(function()
        while Balloon.AutoFarm do
            local worlds = Balloon.SelectedWorlds
            if not worlds or #worlds == 0 then
                Balloon.Status = "selecione mundos"
                task.wait(1)
            else
                for _, worldName in ipairs(worlds) do
                    if not Balloon.AutoFarm then break end
                    Balloon.Status = "indo para " .. tostring(worldName)
                    Balloon.TravelToWorld(worldName)
                    task.wait(Balloon.WorldDelay)
                    pcall(LoadAllCoinsInternal)
                    while Balloon.AutoFarm and #Balloon.List() > 0 do
                        Balloon.Status = "farmando " .. tostring(worldName)
                        Balloon.FarmOnce()
                        task.wait(FarmSpeed or 0.15)
                        pcall(LoadAllCoinsInternal)
                    end
                    task.wait(Balloon.WorldDelay)
                end
                if Balloon.AutoFarm and Balloon.ResetVipAfterLoop then
                    Balloon.Status = "reset VIP"
                    Balloon.RejoinVip()
                    task.wait(Balloon.RejoinDelay)
                end
            end
        end
        Balloon.Status = "idle"
    end)
end

