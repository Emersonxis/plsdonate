    local vNum = variantToNum[variantName] or 4
    local names = {}
    MissingNameToId = {}
    refreshData()
    local collection = Data and Data.Collection or {}
    local owned = {}
    for _, key in ipairs(collection) do
        owned[tostring(key)] = true
    end
    local all = {}
    pcall(function()
        all = Library.Shared.GetAllCollectablePets() or {}
    end)
    local seen = {}
    for _, entry in ipairs(all) do
        local want =
            (vNum == 1 and not entry.isGolden and not entry.isRainbow and not entry.isDarkMatter)
            or (vNum == 2 and entry.isGolden)
            or (vNum == 3 and entry.isRainbow)
            or (vNum == 4 and entry.isDarkMatter)
        if want then
            local key = tostring(entry.petId) .. "-" .. vNum
            if not owned[key] then
                local petName = tostring(entry.petId)
                pcall(function()
                    local dir = Library.Directory.Pets[entry.petId] or Library.Directory.Pets[tostring(entry.petId)]
                    if dir and dir.name then petName = dir.name end
                end)
                if not seen[petName] then
                    seen[petName] = true
                    table.insert(names, petName)
                    MissingNameToId[petName] = entry.petId
                end
            end
        end
    end
    table.sort(names)
    MissingPetNames = names
    return names
end

