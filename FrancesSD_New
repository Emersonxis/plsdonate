function openMachineGui(names)
    local aliases = names or {}
    local function normalize(value)
        return tostring(value or ""):lower():gsub("[^%w]", "")
    end
    if listAllPlayerGuis then
        for _, actualName in ipairs(listAllPlayerGuis()) do
            local actual = normalize(actualName)
            for _, alias in ipairs(aliases) do
                local wanted = normalize(alias)
                if actual == wanted or actual:find(wanted, 1, true) or wanted:find(actual, 1, true) then
                    if setPlayerGuiEnabled and setPlayerGuiEnabled(actualName, true) then return true end
                end
            end
        end
    end
    for _, guiName in ipairs(aliases) do
        if setPlayerGuiEnabled and setPlayerGuiEnabled(guiName, true) then return true end
    end
    return false
end
