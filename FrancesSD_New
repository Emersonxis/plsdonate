function daycareRemainingTime(save, entry)
    local remaining
    pcall(function()
        local fn = Library.Shared and Library.Shared.DaycareComputeRemainingTime
        if type(fn) == "function" then remaining = fn(save, entry) end
    end)
    return math.max(0, tonumber(remaining) or 21600)
end

function daycareHasReadyQueue(save)
    local queue = save and save.DaycareQueue
    if type(queue) ~= "table" then return false end
    for _, entry in ipairs(queue) do
        if type(entry) == "table" and daycareRemainingTime(save, entry) <= 0 then return true end
    end
    return false
end

function daycareSelectedPetUIDs(save)
    local selected, seen = {}, {}
    if not save or type(save.Pets) ~= "table" then return selected end
    for _, wantedName in ipairs(DaycareState.PetNames or {}) do
        local wanted = tostring(wantedName):lower()
        for _, pet in ipairs(save.Pets) do
            if pet and pet.uid and not seen[tostring(pet.uid)]
                and not isBlacklisted(pet.uid) and not isPetLocked(pet)
                and tostring(petDisplayName(pet.id)):lower() == wanted then
                seen[tostring(pet.uid)] = true
                table.insert(selected, pet.uid)
            end
        end
    end
    local maxSlots = 0
    pcall(function()
        maxSlots = Library.Shared.DaycareComputeSlotsForTier(save.DaycareTier)
    end)
    if maxSlots <= 0 then
        maxSlots = 10 + math.max(0, tonumber(save.DaycareTier) or 0) * 10
    end
    local queue = type(save.DaycareQueue) == "table" and save.DaycareQueue or {}
    local remaining = math.max(0, maxSlots - #queue)
    while #selected > remaining do table.remove(selected) end
    return selected
end

function daycareTravelAndEnroll()
    local savedWorld, savedCFrame
    pcall(function()
        savedWorld = WorldCmdsOld and WorldCmdsOld.Get and WorldCmdsOld.Get()
        if HumanoidRootPart and HumanoidRootPart.Parent then savedCFrame = HumanoidRootPart.CFrame end
    end)
    local okTravel, spawnKey = worldHopTravel("Spawn World")
    if not okTravel or not daycareWaitForWorld(spawnKey) then return false end
    pcall(function()
        if HumanoidRootPart and HumanoidRootPart.Parent then
            HumanoidRootPart.CFrame = CFrame.new(DaycareState.Position)
        end
    end)
    task.wait(0.8)
    refreshData()
    local uids = daycareSelectedPetUIDs(Data)
    if #uids > 0 then
        pcall(function() Network.Invoke("Daycare: Enroll", uids) end)
        task.wait(0.8)
    end
    if savedWorld then
        local returnOk, returnKey = worldHopTravel(savedWorld)
        if returnOk and daycareWaitForWorld(returnKey) and savedCFrame then
            pcall(function() HumanoidRootPart.CFrame = savedCFrame end)
        end
    end
    return #uids > 0
end

function daycareRunCycle()
    refreshData()
    if daycareHasReadyQueue(Data) then
        pcall(function() Network.Invoke("Daycare: Claim", nil) end)
        task.wait(1)
        refreshData()
    end
    local queue = Data and Data.DaycareQueue
    if type(queue) == "table" and #queue > 0 then return end
    if #daycareSelectedPetUIDs(Data) > 0 then daycareTravelAndEnroll() end
end

