local function buildDeletePetNameOptions()
    local names, seen = {}, {}
    local directory = Pets_Directory
    if type(directory) ~= "table" then
        directory = Library.Directory and Library.Directory.Pets or {}
    end
    for _, info in pairs(directory or {}) do
        if type(info) == "table" then
            local name = info.name or info.Name or info.displayName or info.DisplayName
            if name and tostring(name) ~= "" and not seen[tostring(name)] then
                seen[tostring(name)] = true
                table.insert(names, tostring(name))
            end
        end
    end
    for _, name in pairs(ExclusivePetIdToName) do
        if name and name ~= "" and not seen[tostring(name)] then
            seen[tostring(name)] = true
            table.insert(names, tostring(name))
        end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    DeletePetNameSet = seen
    DeletePetNameOptions = names
    return names
end

