        if type(v) == "string" then set[v:lower()] = true end
        if type(v) == "table" then
            local n = v.name or v.Name or v.id or v.Id or v.boost or v.Boost
            if n then set[tostring(n):lower()] = true end
        end
    end
    return set
end

function activateMissingServerBoosts()
    local names = getServerBoostNames()
    local active = {}
    pcall(function()
        if Library.ServerBoosts and Library.ServerBoosts.GetActiveBoosts then
            active = activeBoostSet(Library.ServerBoosts.GetActiveBoosts() or {})
        end
    end)
    local attempted = 0
    for _, name in ipairs(names) do
        if not active[name:lower()] then
            attempted = attempted + 1
            local fired = pcall(function()
                Network.Fire("Activate Server Boost", name)
            end)
            if not fired then
                pcall(function()
                    Network.Invoke("Activate Server Boost", name)
                end)
            end
            task.wait(0.15)
        end
    end
    return #names, attempted
end

