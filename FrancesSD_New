    if not pet then return false end
    local powers = pet.powers or pet.Powers or pet.enchants or pet.Enchants
    if type(powers) ~= "table" then return false end
    for _, pow in pairs(powers) do
        local title = nil
        pcall(function()
            local powerId = pow[1] or pow.id or pow.Id or pow.power or pow.Power
            local tierIdx = pow[2] or pow.tier or pow.Tier or pow.level or pow.Level
            local def = Library.Directory.Powers and (Library.Directory.Powers[powerId] or Library.Directory.Powers[tostring(powerId)])
            if def and def.tiers then
                local tier = def.tiers[tonumber(tierIdx) or tierIdx]
                title = (tier and tier.title) or def.title
            end
            title = title or pow.title or pow.Title or pow.name or pow.Name
        end)
        if title then
            for _, want in ipairs(SelectedEnchantTitles) do
                local t = string.lower(tostring(title))
                local w = string.lower(tostring(want))
                if t == w or t:find(w, 1, true) then return true end
            end
        end
    end
    return false
end

