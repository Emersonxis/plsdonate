local function collectExclusivePetNames(node, hint, depth)
    if type(node) ~= "table" or (depth or 0) > 7 then return end
    local petData = node.PetData or node.petData
    if type(petData) == "table" then
        local petId = petData.id or petData.Id or petData.petId or petData.PetId or petData[2]
        if petId and hint and tostring(hint) ~= "PetData" then
            ExclusivePetIdToName[tostring(petId)] = tostring(hint)
        end
    end
    for key, value in pairs(node) do
        if type(value) == "table" then
            local nextHint = hint
            if type(key) == "string" and key ~= "PetData" and key ~= "petData" and key ~= "extraData" then
                nextHint = key
            end
            collectExclusivePetNames(value, nextHint, (depth or 0) + 1)
        end
    end
end

