local function resolveFrameworkEggId(selected)
    if not IsFrameworkBackend then return selected end
    local selectedText = tostring(selected or "")
    local ok, eggs = pcall(function()
        return FrameworkWorldCmds and FrameworkWorldCmds.GetAllEggs and FrameworkWorldCmds.GetAllEggs()
    end)
    if ok and type(eggs) == "table" then
        for _, egg in ipairs(eggs) do
            local id = egg and egg.GetAttribute and egg:GetAttribute("ID")
            if id then
                local info = Egg_Directory[tostring(id)] or Egg_Directory[id]
                local display = type(info) == "table" and (info.displayName or info.name)
                if tostring(id) == selectedText or tostring(display or "") == selectedText
                    or (egg.Name and egg.Name == selectedText) then
                    return id
                end
            end
        end
    end
    local direct = Egg_Directory[selectedText]
    if type(direct) == "table" and direct.id then return direct.id end
    return selected
end

local function frameworkHasTripleEgg()
    if not IsFrameworkBackend then return false end
    local save
    pcall(function() save = FrameworkSave and FrameworkSave.Get() end)
    local settings = save and save.AutoHatchSettings
    if type(settings) == "table" and settings.TripleEggs ~= nil then
        return settings.TripleEggs == true
    end
    local passes = save and (save.Gamepasses or save.GamePasses)
    if type(passes) ~= "table" then return false end
    return passes["Triple Egg Open"] == true
        or passes.TripleEggOpen == true
        or passes["Triple Egg"] == true
end

local function frameworkCoinSnapshot()
    local result = {}
    local coins = FrameworkThings and FrameworkThings.Coins
    if not coins then return result end
    for _, coin in pairs(coins:GetChildren()) do
        local id = coin:GetAttribute("ID")
        local pos = coin:FindFirstChild("POS")
        if id and pos then
            result[tostring(id)] = {
                p = pos.Position,
                n = coin:GetAttribute("Name") or coin.Name,
                instance = coin,
            }
        end
    end
    return result
end


