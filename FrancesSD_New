local function buildWorldHopOptions()
    local result, keys = {}, {}
    local worlds = Library and Library.Directory and Library.Directory.Worlds
    if type(worlds) == "table" then
        for key, info in pairs(worlds) do
            if type(info) == "table" and not info.hidden and info.isVIP ~= true then
                local display = tostring(info.display or info.displayName or info.name or key)
                table.insert(result, display)
                keys[display] = tostring(key)
            end
        end
    end
    if #result == 0 then
        result = {
            "Spawn World", "Fantasy World", "Tech World", "Axolotl Ocean",
            "Pixel World", "Cat World", "Doodle World", "Kawaii World",
            "Limbo World", "Void World",
        }
    end
    table.sort(result, function(a, b) return worldRank(a) < worldRank(b) end)
    WorldHopOld.WorldKeys = keys
    return result
end

local function resolveWorldHopKey(display)
    display = tostring(display or "")
    if WorldHopOld.WorldKeys[display] then return WorldHopOld.WorldKeys[display] end
    local worlds = Library and Library.Directory and Library.Directory.Worlds
    if type(worlds) == "table" then
        for key, info in pairs(worlds) do
            local shown = type(info) == "table" and (info.display or info.displayName or info.name)
            if tostring(key) == display or tostring(shown or "") == display then
                return tostring(key)
            end
        end
    end
    local fallback = display:gsub(" World$", "")
    return fallback == "Spawn" and "Spawn" or fallback
end

local function worldHopTargetMatches(coin)
    if not coin or not coin.p or not coin.n or #SniperTargets == 0 then return false end
    return matchesFarmPriority(coin.n, SniperTargets)
end

local function worldHopCountTargets()
    local count = 0
    for _, coin in pairs(ServerCoins or {}) do
        if worldHopTargetMatches(coin) then count = count + 1 end
    end
    return count
end

local function worldHopTravel(worldName)
    local worldKey = resolveWorldHopKey(worldName)
    local worldCmds = WorldCmdsOld
    if type(worldCmds) == "table" and type(worldCmds.Load) == "function" then
        local ok = pcall(function() worldCmds.Load(worldKey) end)
        return ok, worldKey
    end
    -- Fallback compatível com versões Old que ainda expõem somente o remote.
    local ok = pcall(function() Network.Fire("Request World", worldKey) end)
    return ok, worldKey
end

local function worldHopWaitForLoad(worldKey)
    local started = tick()
    while WorldHopOld.Enabled and tick() - started < (WorldHopOld.LoadTimeout or 12) do
        local loaded = false
        pcall(function()
            if WorldCmdsOld and WorldCmdsOld.HasLoaded then
                loaded = WorldCmdsOld.HasLoaded() == true
            end
        end)
        local current = nil
        pcall(function()
            if WorldCmdsOld and WorldCmdsOld.Get then current = WorldCmdsOld.Get() end
        end)
        if loaded and (not worldKey or tostring(current) == tostring(worldKey)) then
            -- O mapa já existe, mas os coins chegam depois. Não testar a
            -- ausência antes deste intervalo, senão o hop troca de mundo
            -- enquanto os breakables ainda estão spawnando.
            task.wait(math.max(1, tonumber(WorldHopOld.SpawnDelay) or 3))
            pcall(LoadAllCoinsInternal)
            return true
        end
        task.wait(0.35)
    end
    return false
end

local function worldHopFarmSelected()
    local pets = getEquippedPets()
    local targets = {}
    for id, coin in pairs(ServerCoins or {}) do
        if worldHopTargetMatches(coin) then table.insert(targets, { id = id, p = coin.p }) end
    end
    while #targets > math.max(1, MAX_BREAKABLES or 1) do table.remove(targets) end
    if #pets == 0 or #targets == 0 then return 0 end
    local byTarget = {}
    for i, petUID in ipairs(pets) do
        local target = targets[((i - 1) % #targets) + 1]
        byTarget[target.id] = byTarget[target.id] or {}
        table.insert(byTarget[target.id], petUID)
    end
    for targetId, assigned in pairs(byTarget) do
        pcall(function() Network.Invoke("Join Coin", targetId, assigned) end)
        for _, petUID in ipairs(assigned) do
            pcall(function()
                Network.Fire("Change Pet Target", petUID, "Coin", targetId)
                Network.Fire("Farm Coin", targetId, petUID)
            end)
        end
    end
    return #targets
end

local function worldHopConfirmNoRespawn()
    -- Um breakable pode reaparecer alguns segundos depois do último ser
    -- destruído. Confirma três snapshots vazios separados por um intervalo.
    task.wait(math.max(1, tonumber(WorldHopOld.SpawnDelay) or 3))
    local emptyChecks = 0
    for _ = 1, 3 do
        if not WorldHopOld.Enabled then return false end
        pcall(LoadAllCoinsInternal)
        if worldHopCountTargets() > 0 then return false end
        emptyChecks = emptyChecks + 1
        task.wait(0.75)
    end
    return emptyChecks >= 3
end

local function worldHopRejoinVip()
    local text = tostring(WorldHopOld.VipLink or "")
    local code = text:match("[?&]code=([%w%-]+)") or text:match("^([%w%-]+)$")
    if not code then return false end
    return pcall(function()
        game:GetService("TeleportService"):TeleportToPrivateServer(game.PlaceId, code, { player })
    end)
end

function WorldHopOld.Run()
    if WorldHopOld.Running then return end
    WorldHopOld.Running = true
    task.spawn(function()
        local completedLoops = 0
        while WorldHopOld.Enabled do
            if #SniperTargets == 0 then
                task.wait(0.5)
            else
                for _, worldName in ipairs(WorldHopOld.Worlds) do
                    if not WorldHopOld.Enabled then break end
                    local travelled, worldKey = worldHopTravel(worldName)
                    if not travelled or not worldHopWaitForLoad(worldKey) then
                        task.wait(1)
                        continue
                    end
                    local hadTargets = false
                    while WorldHopOld.Enabled do
                        pcall(LoadAllCoinsInternal)
                        local countBeforeFarm = worldHopCountTargets()
                        if countBeforeFarm > 0 then hadTargets = true end
                        local count = worldHopFarmSelected()
                        if count == 0 then
                            if hadTargets then
                                if worldHopConfirmNoRespawn() then break end
                            else
                                -- O mundo já teve tempo de spawn em
                                -- worldHopWaitForLoad; uma segunda leitura
                                -- evita trocar durante uma atualização curta.
                                task.wait(1.5)
                                pcall(LoadAllCoinsInternal)
                                if worldHopCountTargets() == 0 then break end
                            end
                        end
                        task.wait(FarmSpeed or 0.15)
                    end
                    task.wait(math.max(0, tonumber(WorldHopOld.Delay) or 5))
                end
                completedLoops = completedLoops + 1
                local loopLimit = math.max(1, math.floor(tonumber(WorldHopOld.LoopsBeforeRejoin) or 2))
                if WorldHopOld.Enabled and WorldHopOld.RejoinAfterLoop and completedLoops >= loopLimit then
                    worldHopRejoinVip()
                    task.wait(math.max(2, tonumber(WorldHopOld.RejoinDelay) or 5))
                    completedLoops = 0
                end
            end
        end
        WorldHopOld.Running = false
    end)
end

