local AutoFreeGifts = true
local FreeGiftPollDelay = 0.5
local function searchArray(arr, value)
    if type(arr) ~= "table" then return false end
    if Library.Functions and Library.Functions.SearchArray then
        local ok, res = pcall(function()
            return Library.Functions.SearchArray(arr, value)
        end)
        if ok then return res and true or false end
    end
    for _, v in ipairs(arr) do
        if v == value then return true end
    end
    return false
end

local function claimFreeGiftsOfficial()
    local save = Library.Save.Get()
    if not save then return end
    local dir = Library.Directory and Library.Directory.FreeGifts
    if type(dir) ~= "table" then return end
    local redeemed = save.FreeGiftsRedeemed or {}
    local giftTime = tonumber(save.FreeGiftsTime) or 0
    -- Dump FreeGifts: ipairs index + waitTime <= FreeGiftsTime e nao esta em FreeGiftsRedeemed
    for i, gift in ipairs(dir) do
        if not AutoFreeGifts then break end
        local already = searchArray(redeemed, i)
        local waitTime = type(gift) == "table" and tonumber(gift.waitTime) or nil
        if not already and waitTime and giftTime >= waitTime then
            pcall(function()
                Network.Invoke("Redeem Free Gift", i)
            end)
            task.wait(0.05)
        end
    end
end

