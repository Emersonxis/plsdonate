-- Seleciona a Library mais completa entre a variante Framework e a legada.
local function libraryScore(lib)
    if type(lib) ~= "table" then return -1 end
    local score = 0
    local net = lib.Network
    local dir = lib.Directory
    local save = lib.Save
    if type(net) == "table" then
        if type(net.Invoke) == "function" then score = score + 3 end
        if type(net.Fire) == "function" then score = score + 2 end
        if type(net.Fired) == "function" then score = score + 1 end
    end
    if type(dir) == "table" then
        if type(dir.Pets) == "table" then score = score + 2 end
        if type(dir.Eggs) == "table" then score = score + 1 end
        if type(dir.Coins) == "table" then score = score + 1 end
        if type(dir.Areas) == "table" then score = score + 1 end
        if type(dir.Worlds) == "table" then score = score + 1 end
    end
    if type(save) == "table" and type(save.Get) == "function" then score = score + 2 end
    if type(lib.PetCmds) == "table" then score = score + 1 end
    if type(lib.WorldCmds) == "table" then score = score + 1 end
    if lib.Loaded ~= nil then score = score + 1 end
    return score
end

local function addLibraryCandidate(list, seen, instance, path)
    if not instance or not instance:IsA("ModuleScript") or seen[instance] then return end
    seen[instance] = true
    table.insert(list, { instance = instance, path = path })
end

local function resolveLibrary()
    local candidates, seen = {}, {}
    local framework = ReplicatedStorage:FindFirstChild("Framework")
    local legacy = ReplicatedStorage:FindFirstChild("Library")
    local modules = ReplicatedStorage:FindFirstChild("Modules")

    if framework then
        addLibraryCandidate(candidates, seen, framework:FindFirstChild("Library"), "ReplicatedStorage.Framework.Library")
    end
    addLibraryCandidate(candidates, seen, legacy, "ReplicatedStorage.Library")
    if modules then
        addLibraryCandidate(candidates, seen, modules:FindFirstChild("Library"), "ReplicatedStorage.Modules.Library")
    end

    -- Aguarda os caminhos comuns somente se ainda não apareceram.
    if #candidates == 0 then
        local fw = ReplicatedStorage:WaitForChild("Framework", 10)
        if fw then addLibraryCandidate(candidates, seen, fw:FindFirstChild("Library"), "ReplicatedStorage.Framework.Library") end
        addLibraryCandidate(candidates, seen, ReplicatedStorage:WaitForChild("Library", 5), "ReplicatedStorage.Library")
    end

    -- O alvo atual é a Library Old. Se o caminho clássico existir e for
    -- funcional, ele tem prioridade para não mudar o backend já estável.
    local legacyLib, legacyPath, legacyScore = nil, nil, -1
    for _, candidate in ipairs(candidates) do
        if candidate.path == "ReplicatedStorage.Library" then
            local ok, lib = pcall(require, candidate.instance)
            if ok and lib then
                local score = libraryScore(lib)
                if score > legacyScore then
                    legacyLib, legacyPath, legacyScore = lib, candidate.path, score
                end
            end
        end
    end
    if legacyLib and legacyScore >= 8 then
        return legacyLib, legacyPath, legacyScore
    end

    local bestLib, bestPath, bestScore = nil, nil, -1
    for _, candidate in ipairs(candidates) do
        local ok, lib = pcall(require, candidate.instance)
        if ok and lib then
            local score = libraryScore(lib)
            if score > bestScore then
                bestLib, bestPath, bestScore = lib, candidate.path, score
            end
        end
    end
    if not bestLib or bestScore < 8 then
        error("[PSX Mod Hub] Nenhuma Library funcional foi encontrada. Aguarde o carregamento do mod e tente novamente.")
    end
    return bestLib, bestPath, bestScore
end

