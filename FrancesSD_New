function isPetMarkedForDeletion(pet)
    if not pet or not pet.uid then return false end
    if isBlacklisted(pet.uid) or isPetLocked(pet) then return false end

    local petName = petDisplayName(pet.id)
    if AutoDeleteByName and #SelectedDeletePetNames > 0 then
        for _, selectedName in ipairs(SelectedDeletePetNames) do
            local wanted = tostring(selectedName):lower()
            if petName:lower() == wanted
                or tostring(ExclusivePetIdToName[tostring(pet.id)] or ""):lower() == wanted then
                return true
            end
        end
    end

    if AutoDeleteByCraft and #SelectedDeleteCrafts > 0 then
        local craft = getPetCraftVariant(pet)
        if craft then
            for _, selectedCraft in ipairs(SelectedDeleteCrafts) do
                if tostring(selectedCraft):lower() == craft:lower() then return true end
            end
        end
    end

    local rarity = tostring(pet.rarity or "")
    local info = Pets_Directory[tostring(pet.id)] or Pets_Directory[pet.id]
    rarity = tostring(info and (info.rarity or info.Rarity) or rarity)
    if AutoDelete and table.find(Auto_Delete_Rarity or {}, rarity) and not isHugePet(pet.id) then
        return true
    end

    local save = Library and Library.Save and Library.Save.Get and Library.Save.Get()
    local rules = save and save.AutoDelete
    local mode = rules and rules[rarity]
    if mode == 2 then return not (pet.g or pet.r or pet.dm) end
    if mode == 3 then return not (pet.r or pet.dm) end
    if mode == 4 then return true end
    return false
end

local function farmCoinHealth(coin)
    if type(coin) ~= "table" then return 0 end
    return tonumber(coin.h or coin.hp or coin.health or coin.Health or coin.m or coin.maxHealth) or 0
end

local function farmCoinName(coin)
    return tostring(coin and (coin.n or coin.name or coin.Name) or "")
end

local function matchesFarmPriority(name, selected)
    if not selected or #selected == 0 then return true end
    local lowerName = tostring(name or ""):lower()
    for _, wanted in ipairs(selected) do
        local lowerWanted = tostring(wanted):lower()
        if lowerName == lowerWanted or lowerName:find(lowerWanted, 1, true) then
            return true
        end
    end
    return false
end

function collectGlobalPriorityTargets(origin)
    local targets = {}
    if not GlobalPriorityTargets or #GlobalPriorityTargets == 0 then return targets end
    for id, coin in pairs(ServerCoins or {}) do
        if coin and coin.p and matchesFarmPriority(farmCoinName(coin), GlobalPriorityTargets) then
            table.insert(targets, {
                id = id,
                p = coin.p,
                name = farmCoinName(coin),
                health = farmCoinHealth(coin),
                distance = origin and (coin.p - origin).Magnitude or 0,
            })
        end
    end
    table.sort(targets, function(a, b) return a.distance < b.distance end)
    while #targets > math.max(1, MAX_BREAKABLES or 1) do table.remove(targets) end
    return targets
end

local function collectAreaFarmTargets(areaName, method, selected, origin)
    local targets = {}
    for id, coin in pairs(ServerCoins or {}) do
        if coin and coin.p and coin.a == areaName then
            local name = farmCoinName(coin)
            if method ~= "Priority" or matchesFarmPriority(name, selected) then
                table.insert(targets, {
                    id = id,
                    p = coin.p,
                    name = name,
                    health = farmCoinHealth(coin),
                    distance = origin and (coin.p - origin).Magnitude or 0,
                })
            end
        end
    end
    if method == "More Health" then
        table.sort(targets, function(a, b) return a.health > b.health end)
    elseif method == "Less Health" then
        table.sort(targets, function(a, b) return a.health < b.health end)
    elseif method == "Random" then
        for i = #targets, 2, -1 do
            local j = math.random(1, i)
            targets[i], targets[j] = targets[j], targets[i]
        end
    else
        table.sort(targets, function(a, b) return a.distance < b.distance end)
    end
    while #targets > math.max(1, MAX_BREAKABLES or 1) do
        table.remove(targets)
    end
    return targets
end

local function assignFarmPets(pets, targets)
    local assigned = {}
    if not pets or #pets == 0 or not targets or #targets == 0 then return assigned end
    if PetAssignMode == "OnePerBreakable" then
        for i = 1, math.min(#pets, #targets) do
            assigned[targets[i].id] = { pets[i] }
        end
    else
        for i, petUID in ipairs(pets) do
            local target = targets[((i - 1) % #targets) + 1]
            assigned[target.id] = assigned[target.id] or {}
            table.insert(assigned[target.id], petUID)
        end
    end
    return assigned
end

local function fireFarmAssignments(assigned)
    for targetId, pets in pairs(assigned or {}) do
        task.spawn(function()
            pcall(function() Network.Invoke("Join Coin", targetId, pets) end)
            for _, petUID in ipairs(pets) do
                pcall(function()
                    Network.Fire("Change Pet Target", petUID, "Coin", targetId)
                    farmCoinCompat(targetId, petUID)
                end)
            end
        end)
    end
end

